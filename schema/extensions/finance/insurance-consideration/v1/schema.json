{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/finance/insurance-consideration/v1/schema.json",
  "title": "PremiumConsideration",
  "description": "ION Finance Insurance Consideration Extension v1 — premium amounts placed in Contract.consideration[].considerationAttributes.",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "totalPremiumIDR",
    "currency",
    "paymentFrequency",
    "breakup"
  ],
  "additionalProperties": true,
  "properties": {
    "@context": {
      "type": "string",
      "const": "https://schema.ion.id/finance/insurance-consideration/v1/context.jsonld"
    },
    "@type": {
      "type": "string",
      "const": "ion:PremiumConsideration"
    },
    "totalPremiumIDR": {
      "type": "number",
      "description": "Total premium payable by policyholder in IDR including all fees and taxes."
    },
    "currency": {
      "type": "string",
      "const": "IDR",
      "description": "ISO 4217 currency code. Always IDR for domestic insurance."
    },
    "paymentFrequency": {
      "type": "string",
      "enum": ["ANNUAL", "SEMI_ANNUAL", "QUARTERLY", "MONTHLY"],
      "description": "Premium payment frequency."
    },
    "breakup": {
      "type": "array",
      "items": { "$ref": "#/$defs/PremiumBreakupItem" },
      "minItems": 1
    },
    "addOnPremiums": {
      "type": "array",
      "items": { "$ref": "#/$defs/AddOnPremiumItem" }
    },
    "ncdDiscountIDR": {
      "type": "number",
      "description": "No Claims Discount amount in IDR deducted from base premium."
    }
  },
  "$defs": {
    "PremiumBreakupItem": {
      "title": "PremiumBreakupItem",
      "type": "object",
      "required": ["type", "amountIDR"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["BASE_PREMIUM", "ADD_ON_PREMIUM", "ADMIN_FEE", "STAMP_DUTY", "TAX_PPN", "TAX_PPH", "NCD_DISCOUNT", "LOADING"]
        },
        "amountIDR": { "type": "number" },
        "description": { "type": "string" }
      }
    },
    "AddOnPremiumItem": {
      "title": "AddOnPremiumItem",
      "type": "object",
      "required": ["code", "name", "premiumIDR"],
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "premiumIDR": { "type": "number" }
      }
    }
  }
}
