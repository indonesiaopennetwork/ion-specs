{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ion": "https://schema.ion.id/finance/performance/v1#",
    "schema": "https://schema.org/",
    "beckn": "https://schema.beckn.io/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:DisbursementPerformance",
      "@type": "rdfs:Class",
      "rdfs:comment": "Loan disbursement execution record.",
      "rdfs:subClassOf": {
        "@id": "schema:PaymentMethod"
      },
      "skos:broader": {
        "@id": "https://spec.beckn.io/vocab/v2.0.0#Performance"
      }
    },
    {
      "@id": "ion:IONDisbursementPerformance",
      "@type": "rdfs:Class",
      "rdfs:comment": "ION-specific disbursement performance attributes.",
      "rdfs:subClassOf": {
        "@id": "ion:DisbursementPerformance"
      },
      "skos:broader": {
        "@id": "ion:DisbursementPerformance"
      }
    },
    {
      "@id": "ion:disbursementDate",
      "rdf:type": "rdf:Property",
      "rdfs:comment": "Date funds were actually disbursed."
    },
    {
      "@id": "ion:targetBusinessDays",
      "rdf:type": "rdf:Property",
      "rdfs:comment": "Target working days from document completion to disbursement."
    },
    {
      "@id": "ion:disbursementMethod",
      "rdf:type": "rdf:Property",
      "rdfs:comment": "Transfer mechanism: BANK_TRANSFER, DEVELOPER_TRANSFER, DEALER_TRANSFER, CASH, VIRTUAL_ACCOUNT."
    }
  ]
}
