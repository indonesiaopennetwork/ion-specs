{
  "id": "ion-finance-insurance-participant-v1",
  "version": "1.0.0",
  "domain": "finance",
  "type": "AttributePack",
  "name": "ION Finance Insurance Participant Extension (v1)",
  "packSchema": "./schema.json",
  "jsonldContext": "./context.jsonld",
  "extends": "beckn:Participant",
  "attachmentPoints": {
    "participantAttributes": [
      "Policyholder",
      "Insurer"
    ]
  },
  "indexing": {
    "indexable": [
      { "path": "$.nik" },
      { "path": "$.kycStatus" },
      { "path": "$.ojkIknbLicense" }
    ],
    "filterable": [
      { "path": "$.kycStatus" }
    ],
    "sortable": []
  },
  "minimalForDiscovery": [
    "nik",
    "kycStatus"
  ],
  "context": {
    "schemaContext": [
      "https://schema.ion.id/finance/insurance-participant/v1/context.jsonld"
    ]
  }
}
