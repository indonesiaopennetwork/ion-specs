{
  "@context": {
    "ion": "https://schema.ion.id/finance/insurance-participant/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "beckn": "https://schema.beckn.io/",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:Policyholder",
      "@type": "rdfs:Class",
      "rdfs:label": "Policyholder",
      "rdfs:comment": "Policyholder identity attributes placed in Contract.participants[] with participantAttributes[@type] = ion:Policyholder.",
      "rdfs:subClassOf": { "@id": "schema:Person" }
    },
    {
      "@id": "ion:nik",
      "@type": "rdf:Property",
      "rdfs:label": "nik",
      "rdfs:comment": "Nomor Induk Kependudukan — 16-digit national ID from KTP (e-KTP).",
      "rdfs:domain": { "@id": "ion:Policyholder" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:npwp",
      "@type": "rdf:Property",
      "rdfs:label": "npwp",
      "rdfs:comment": "Nomor Pokok Wajib Pajak — required when annual premium exceeds IDR 5 juta for PPh withholding.",
      "rdfs:domain": { "@id": "ion:Policyholder" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:driverLicenseType",
      "@type": "rdf:Property",
      "rdfs:label": "driverLicenseType",
      "rdfs:comment": "Indonesian SIM driver license class. Values: SIM_A (passenger car), SIM_B1 (heavy vehicle), SIM_B2 (articulated), SIM_C (motorcycle), SIM_D (disability).",
      "rdfs:domain": { "@id": "ion:Policyholder" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:kycStatus",
      "@type": "rdf:Property",
      "rdfs:label": "kycStatus",
      "rdfs:comment": "eKYC verification status per OJK SP-30/D.05/2020. Values: APPROVED, PENDING, REJECTED, EXPIRED.",
      "rdfs:domain": { "@id": "ion:Policyholder" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:kycExpiry",
      "@type": "rdf:Property",
      "rdfs:label": "kycExpiry",
      "rdfs:comment": "Date after which kycStatus expires and re-verification is required.",
      "rdfs:domain": { "@id": "ion:Policyholder" },
      "rdfs:range": { "@id": "xsd:date" }
    },
    {
      "@id": "ion:Insurer",
      "@type": "rdfs:Class",
      "rdfs:label": "Insurer",
      "rdfs:comment": "Insurance company identity attributes placed in Contract.participants[] with participantAttributes[@type] = ion:Insurer.",
      "rdfs:subClassOf": { "@id": "schema:InsuranceAgency" }
    },
    {
      "@id": "ion:ojkIknbLicense",
      "@type": "rdf:Property",
      "rdfs:label": "ojkIknbLicense",
      "rdfs:comment": "OJK IKNB (Industri Keuangan Non-Bank) operating license number for general insurance (asuransi umum).",
      "rdfs:domain": { "@id": "ion:Insurer" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:companyName",
      "@type": "rdf:Property",
      "rdfs:label": "companyName",
      "rdfs:comment": "Full legal entity name as registered with OJK and Kemenkumham.",
      "rdfs:domain": { "@id": "ion:Insurer" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:lossPayeeIfAny",
      "@type": "rdf:Property",
      "rdfs:label": "lossPayeeIfAny",
      "rdfs:comment": "Name of the designated loss payee (e.g., bank/lender) if this policy is bancassurance-linked (KKB vehicle loan).",
      "rdfs:domain": { "@id": "ion:Insurer" },
      "rdfs:range": { "@id": "xsd:string" }
    }
  ]
}
