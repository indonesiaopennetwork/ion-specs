{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/finance/insurance-participant/v1/schema.json",
  "title": "InsuranceParticipant",
  "description": "ION Finance Insurance Participant Extension v1 — policyholder and insurer identity placed in Contract.participants[].participantAttributes.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/Policyholder" },
    { "$ref": "#/$defs/Insurer" }
  ],
  "additionalProperties": true,
  "$defs": {
    "Policyholder": {
      "title": "Policyholder",
      "type": "object",
      "required": ["@context", "@type", "nik", "kycStatus"],
      "properties": {
        "@context": {
          "type": "string",
          "const": "https://schema.ion.id/finance/insurance-participant/v1/context.jsonld"
        },
        "@type": { "type": "string", "const": "ion:Policyholder" },
        "nik": {
          "type": "string",
          "pattern": "^[0-9]{16}$",
          "description": "Nomor Induk Kependudukan — 16-digit national ID from KTP."
        },
        "npwp": {
          "type": "string",
          "description": "Nomor Pokok Wajib Pajak — required when annual premium > IDR 5 juta."
        },
        "driverLicenseType": {
          "type": "string",
          "enum": ["SIM_A", "SIM_B1", "SIM_B2", "SIM_C", "SIM_D"],
          "description": "Indonesian SIM driver license classification."
        },
        "kycStatus": {
          "type": "string",
          "enum": ["APPROVED", "PENDING", "REJECTED", "EXPIRED"],
          "description": "eKYC verification status per OJK SP-30/D.05/2020."
        },
        "kycExpiry": {
          "type": "string",
          "format": "date",
          "description": "Date on which kycStatus expires and re-verification is required."
        }
      }
    },
    "Insurer": {
      "title": "Insurer",
      "type": "object",
      "required": ["@context", "@type", "ojkIknbLicense", "companyName"],
      "properties": {
        "@context": {
          "type": "string",
          "const": "https://schema.ion.id/finance/insurance-participant/v1/context.jsonld"
        },
        "@type": { "type": "string", "const": "ion:Insurer" },
        "ojkIknbLicense": {
          "type": "string",
          "description": "OJK IKNB operating license number for asuransi umum (general insurance)."
        },
        "companyName": {
          "type": "string",
          "description": "Full legal entity name as registered with OJK."
        },
        "lossPayeeIfAny": {
          "type": "string",
          "description": "Name of the loss payee (e.g., bank/lender) if policy is bancassurance-linked."
        }
      }
    }
  }
}
