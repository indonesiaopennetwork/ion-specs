{
  "id": "ion-finance-insurance-resource-v1",
  "version": "1.0.0",
  "domain": "finance",
  "type": "AttributePack",
  "name": "ION Finance Insurance Resource Extension (v1)",
  "packSchema": "./schema.json",
  "jsonldContext": "./context.jsonld",
  "extends": "beckn:Resource",
  "attachmentPoints": {
    "resourceAttributes": [
      "InsuranceProduct"
    ]
  },
  "indexing": {
    "indexable": [
      { "path": "$.productType" },
      { "path": "$.vehicleType" },
      { "path": "$.tariffZone" },
      { "path": "$.ojkProductCode" },
      { "path": "$.ojkLicenseNumber" },
      { "path": "$.premiumRateRange.min" },
      { "path": "$.premiumRateRange.max" }
    ],
    "filterable": [
      { "path": "$.productType" },
      { "path": "$.vehicleType" },
      { "path": "$.tariffZone" }
    ],
    "sortable": [
      { "path": "$.premiumRateRange.min" },
      { "path": "$.premiumRateRange.max" }
    ]
  },
  "minimalForDiscovery": [
    "productType",
    "vehicleType",
    "tariffZone",
    "premiumRateRange",
    "ojkProductCode",
    "ojkLicenseNumber",
    "coverageInclusions"
  ],
  "context": {
    "schemaContext": [
      "https://schema.ion.id/finance/insurance-resource/v1/context.jsonld"
    ]
  }
}
