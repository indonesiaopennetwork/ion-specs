{
  "@context": {
    "ion": "https://schema.ion.id/finance/insurance-contract/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "beckn": "https://schema.beckn.io/",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:InsurancePolicy",
      "@type": "rdfs:Class",
      "rdfs:label": "InsurancePolicy",
      "rdfs:comment": "Issued insurance policy record. Placed in Beckn Contract.contractAttributes after on_confirm.",
      "rdfs:subClassOf": { "@id": "schema:InsurancePolicy" }
    },
    {
      "@id": "ion:policyNumber",
      "@type": "rdf:Property",
      "rdfs:label": "policyNumber",
      "rdfs:comment": "Unique policy number assigned by insurer's policy management system (PMS). Primary key for OJK reporting.",
      "rdfs:domain": { "@id": "ion:InsurancePolicy" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:certificateUrl",
      "@type": "rdf:Property",
      "rdfs:label": "certificateUrl",
      "rdfs:comment": "HTTPS URL to the digital policy certificate PDF. Must be stable for policy period + 10 years per consumer protection requirements.",
      "rdfs:domain": { "@id": "ion:InsurancePolicy" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "ion:policyStatus",
      "@type": "rdf:Property",
      "rdfs:label": "policyStatus",
      "rdfs:comment": "Policy lifecycle status. Values: PENDING_ISSUANCE, ACTIVE, LAPSED, CANCELLED, EXPIRED, CLAIMED, TOTAL_LOSS.",
      "rdfs:domain": { "@id": "ion:InsurancePolicy" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:coverageStartDate",
      "@type": "rdf:Property",
      "rdfs:label": "coverageStartDate",
      "rdfs:comment": "Date from which insurance coverage is in force (ISO 8601 YYYY-MM-DD).",
      "rdfs:domain": { "@id": "ion:InsurancePolicy" },
      "rdfs:range": { "@id": "xsd:date" }
    },
    {
      "@id": "ion:coverageEndDate",
      "@type": "rdf:Property",
      "rdfs:label": "coverageEndDate",
      "rdfs:comment": "Date on which coverage expires (ISO 8601 YYYY-MM-DD).",
      "rdfs:domain": { "@id": "ion:InsurancePolicy" },
      "rdfs:range": { "@id": "xsd:date" }
    },
    {
      "@id": "ion:sumInsuredIDR",
      "@type": "rdf:Property",
      "rdfs:label": "sumInsuredIDR",
      "rdfs:comment": "Maximum total sum insured under this policy in IDR.",
      "rdfs:domain": { "@id": "ion:InsurancePolicy" },
      "rdfs:range": { "@id": "xsd:decimal" }
    },
    {
      "@id": "ion:actualIDV",
      "@type": "rdf:Property",
      "rdfs:label": "actualIDV",
      "rdfs:comment": "Insured Declared Value agreed and frozen at policy issuance in IDR.",
      "rdfs:domain": { "@id": "ion:InsurancePolicy" },
      "rdfs:range": { "@id": "xsd:decimal" }
    },
    {
      "@id": "ion:ojkPolicyReference",
      "@type": "rdf:Property",
      "rdfs:label": "ojkPolicyReference",
      "rdfs:comment": "OJK IKNB policy reference used in regulatory reporting.",
      "rdfs:domain": { "@id": "ion:InsurancePolicy" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:ClaimRecord",
      "@type": "rdfs:Class",
      "rdfs:label": "ClaimRecord",
      "rdfs:comment": "Single claim event record within a policy's claims history.",
      "rdfs:subClassOf": { "@id": "schema:Event" }
    },
    {
      "@id": "ion:claimReference",
      "@type": "rdf:Property",
      "rdfs:label": "claimReference",
      "rdfs:comment": "Unique claim reference number assigned by insurer on FNOL.",
      "rdfs:domain": { "@id": "ion:ClaimRecord" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:claimType",
      "@type": "rdf:Property",
      "rdfs:label": "claimType",
      "rdfs:comment": "Type of insured event. Values: ACCIDENT, THEFT, THIRD_PARTY_LIABILITY, FIRE, NATURAL_DISASTER.",
      "rdfs:domain": { "@id": "ion:ClaimRecord" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ion:settledAmountIDR",
      "@type": "rdf:Property",
      "rdfs:label": "settledAmountIDR",
      "rdfs:comment": "Net claim settlement amount paid to policyholder or workshop in IDR (after deductible).",
      "rdfs:domain": { "@id": "ion:ClaimRecord" },
      "rdfs:range": { "@id": "xsd:decimal" }
    },
    {
      "@id": "ion:PolicyStatus",
      "@type": ["rdfs:Class", "skos:ConceptScheme"],
      "rdfs:label": "PolicyStatus",
      "rdfs:comment": "Insurance policy lifecycle state taxonomy."
    },
    {
      "@id": "ion:ACTIVE",
      "@type": "skos:Concept",
      "skos:prefLabel": "ACTIVE",
      "skos:broader": { "@id": "ion:PolicyStatus" },
      "rdfs:comment": "Policy is in force and coverage is active."
    },
    {
      "@id": "ion:TOTAL_LOSS",
      "@type": "skos:Concept",
      "skos:prefLabel": "TOTAL_LOSS",
      "skos:broader": { "@id": "ion:PolicyStatus" },
      "rdfs:comment": "Total loss claim settled — policy terminated; IDV paid to policyholder."
    },
    {
      "@id": "ion:EXPIRED",
      "@type": "skos:Concept",
      "skos:prefLabel": "EXPIRED",
      "skos:broader": { "@id": "ion:PolicyStatus" },
      "rdfs:comment": "Coverage period ended without renewal."
    }
  ]
}
