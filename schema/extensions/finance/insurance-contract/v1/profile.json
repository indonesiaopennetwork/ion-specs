{
  "id": "ion-finance-insurance-contract-v1",
  "version": "1.0.0",
  "domain": "finance",
  "type": "AttributePack",
  "name": "ION Finance Insurance Contract Extension (v1)",
  "packSchema": "./schema.json",
  "jsonldContext": "./context.jsonld",
  "extends": "beckn:Contract",
  "attachmentPoints": {
    "contractAttributes": [
      "InsurancePolicy"
    ]
  },
  "indexing": {
    "indexable": [
      { "path": "$.policyNumber" },
      { "path": "$.policyStatus" },
      { "path": "$.coverageStartDate" },
      { "path": "$.coverageEndDate" },
      { "path": "$.sumInsuredIDR" },
      { "path": "$.actualIDV" }
    ],
    "filterable": [
      { "path": "$.policyStatus" }
    ],
    "sortable": [
      { "path": "$.coverageStartDate" },
      { "path": "$.coverageEndDate" },
      { "path": "$.sumInsuredIDR" }
    ]
  },
  "minimalForDiscovery": [
    "policyNumber",
    "certificateUrl",
    "policyStatus",
    "coverageStartDate",
    "coverageEndDate",
    "sumInsuredIDR",
    "actualIDV"
  ],
  "context": {
    "schemaContext": [
      "https://schema.ion.id/finance/insurance-contract/v1/context.jsonld"
    ]
  }
}
