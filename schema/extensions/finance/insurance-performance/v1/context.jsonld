{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "ion": "https://schema.ion.id/finance/insurance-performance/v1#",
    "beckn": "https://schema.beckn.io/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "PolicyPerformance": "ion:PolicyPerformance",
    "PolicyState": "ion:PolicyState",
    "PENDING_ISSUANCE": "ion:PENDING_ISSUANCE",
    "STATE_ACTIVE": "ion:STATE_ACTIVE",
    "CLAIM_FILED": "ion:CLAIM_FILED",
    "RENEWAL_DUE": "ion:RENEWAL_DUE",
    "STATE_TOTAL_LOSS": "ion:STATE_TOTAL_LOSS",
    "SchemaEvent": "schema:Event",
    "string": "xsd:string",
    "date": "xsd:date",
    "integer": "xsd:integer",
    "decimal": "xsd:decimal",
    "policyState": {
      "@id": "ion:policyState",
      "@type": "xsd:string"
    },
    "coveragePeriodStart": {
      "@id": "ion:coveragePeriodStart",
      "@type": "xsd:date"
    },
    "coveragePeriodEnd": {
      "@id": "ion:coveragePeriodEnd",
      "@type": "xsd:date"
    },
    "nextRenewalDueDate": {
      "@id": "ion:nextRenewalDueDate",
      "@type": "xsd:date"
    },
    "claimCount": {
      "@id": "ion:claimCount",
      "@type": "xsd:integer"
    },
    "ncdPercentage": {
      "@id": "ion:ncdPercentage",
      "@type": "xsd:decimal"
    },
    "remainingSumInsuredIDR": {
      "@id": "ion:remainingSumInsuredIDR",
      "@type": "xsd:decimal"
    }
  }
}
