{
  "id": "ion-finance-insurance-performance-v1",
  "version": "1.0.0",
  "domain": "finance",
  "type": "AttributePack",
  "name": "ION Finance Insurance Performance Extension (v1)",
  "packSchema": "./schema.json",
  "jsonldContext": "./context.jsonld",
  "extends": "beckn:Performance",
  "attachmentPoints": {
    "performanceAttributes": [
      "PolicyPerformance"
    ]
  },
  "indexing": {
    "indexable": [
      { "path": "$.policyState" },
      { "path": "$.coveragePeriodStart" },
      { "path": "$.coveragePeriodEnd" },
      { "path": "$.nextRenewalDueDate" },
      { "path": "$.claimCount" }
    ],
    "filterable": [
      { "path": "$.policyState" }
    ],
    "sortable": [
      { "path": "$.coveragePeriodStart" },
      { "path": "$.coveragePeriodEnd" },
      { "path": "$.nextRenewalDueDate" }
    ]
  },
  "minimalForDiscovery": [
    "policyState",
    "coveragePeriodStart",
    "coveragePeriodEnd",
    "nextRenewalDueDate",
    "claimCount"
  ],
  "context": {
    "schemaContext": [
      "https://schema.ion.id/finance/insurance-performance/v1/context.jsonld"
    ]
  }
}
