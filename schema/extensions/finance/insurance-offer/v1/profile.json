{
  "id": "ion-finance-insurance-offer-v1",
  "version": "1.0.0",
  "domain": "finance",
  "type": "AttributePack",
  "name": "ION Finance Insurance Offer Extension (v1)",
  "packSchema": "./schema.json",
  "jsonldContext": "./context.jsonld",
  "extends": "beckn:Offer",
  "attachmentPoints": {
    "offerAttributes": [
      "PolicyQuote"
    ]
  },
  "indexing": {
    "indexable": [
      { "path": "$.approvedIDV" },
      { "path": "$.annualPremiumIDR" },
      { "path": "$.ojkFinalRatePercent" },
      { "path": "$.tariffZone" },
      { "path": "$.quoteValidUntil" }
    ],
    "filterable": [
      { "path": "$.tariffZone" },
      { "path": "$.annualPremiumIDR" }
    ],
    "sortable": [
      { "path": "$.annualPremiumIDR" },
      { "path": "$.approvedIDV" }
    ]
  },
  "minimalForDiscovery": [
    "approvedIDV",
    "annualPremiumIDR",
    "ojkFinalRatePercent",
    "tariffZone",
    "quoteValidUntil",
    "inclusions"
  ],
  "context": {
    "schemaContext": [
      "https://schema.ion.id/finance/insurance-offer/v1/context.jsonld"
    ]
  }
}
