{
  "@context": {
    "ion": "https://schema.ion.id/hospitality/menu-item/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "beckn": "https://schema.beckn.io/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "schema": "https://schema.org/"
  },
  "@graph": [
    {
      "@id": "ion:MenuItem",
      "@type": "rdfs:Class",
      "rdfs:label": "MenuItem",
      "rdfs:comment": "A prepared food or beverage item available for delivery or self-pickup from a restaurant or cloud kitchen. Produced after order placement. Distinct from packaged physical goods.",
      "rdfs:subClassOf": {
        "@id": "beckn:Resource"
      },
      "skos:broader": {
        "@id": "beckn:Resource"
      },
      "owl:sameAs": {
        "@id": "schema:MenuItem"
      }
    },
    {
      "@id": "ion:IONMenuItem",
      "@type": "rdfs:Class",
      "rdfs:label": "IONMenuItem",
      "rdfs:comment": "ION-specific menu item with Indonesian food regulatory attributes (halal certification, allergen declaration, BPOM registration).",
      "rdfs:subClassOf": {
        "@id": "ion:MenuItem"
      },
      "skos:broader": {
        "@id": "ion:MenuItem"
      }
    },
    {
      "@id": "ion:fnb",
      "@type": "rdf:Property",
      "rdfs:label": "fnb",
      "rdfs:comment": "Indonesian food regulatory and dietary attributes sub-object. Contains halal certification, allergen declaration, and BPOM compliance fields.",
      "rdfs:domain": {
        "@id": "ion:IONMenuItem"
      }
    },
    {
      "@id": "ion:classification",
      "@type": "rdf:Property",
      "rdfs:label": "classification",
      "rdfs:comment": "Dietary classification of the menu item (HALAL, NON_HALAL, VEG, NON_VEG, HALAL_PENDING, NOT_APPLICABLE). Governed by UU 33/2014 tentang Jaminan Produk Halal.",
      "rdfs:domain": {
        "@id": "ion:IONMenuItem"
      }
    },
    {
      "@id": "ion:halalCertNumber",
      "@type": "rdf:Property",
      "rdfs:label": "halalCertNumber",
      "rdfs:comment": "MUI/BPJPH halal certificate number. Required when classification is HALAL.",
      "rdfs:domain": {
        "@id": "ion:IONMenuItem"
      }
    },
    {
      "@id": "ion:preparationTime",
      "@type": "rdf:Property",
      "rdfs:label": "preparationTime",
      "rdfs:comment": "ISO 8601 duration from order confirmation to item ready for pickup or dispatch.",
      "rdfs:domain": {
        "@id": "ion:MenuItem"
      }
    },
    {
      "@id": "ion:menuCategory",
      "@type": "rdf:Property",
      "rdfs:label": "menuCategory",
      "rdfs:comment": "Menu section this item belongs to. Drives display order and grouping in consumer apps.",
      "rdfs:domain": {
        "@id": "ion:MenuItem"
      }
    }
  ]
}