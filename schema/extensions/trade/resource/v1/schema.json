{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/trade/resource/v1",
  "title": "ION Trade Resource Schema Pack v1",
  "description": "JSON Schema 2020-12 for the ION trade/resource/v1 schema pack. Root resolves to IONTradeResource (ION layer). TradeResource (generic layer) is defined in $defs and inherited via allOf. Mandatory fields are declared in ion.yaml x-ion-field-requirements — not in this schema.",
  "$ref": "#/$defs/IONTradeResource",
  "$defs": {
    "LocalisedText": {
      "type": "object",
      "description": "Multilingual text object. Keys are BCP-47 language codes (e.g. 'id', 'en'). At least one language key required.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Bahasa Indonesia text"
        },
        "en": {
          "type": "string",
          "description": "English text"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    },
    "TradeResource": {
      "type": "object",
      "title": "TradeResource",
      "description": "Network-agnostic generic layer for trade sector resources. Carries only fields meaningful across any Beckn network. Indonesia-specific regulatory and compliance fields are in IONTradeResource.",
      "additionalProperties": true,
      "properties": {
        "resourceStructure": {
          "type": "string",
          "enum": [
            "PLAIN",
            "VARIANT",
            "WITH_EXTRAS",
            "COMPOSED",
            "BUNDLE"
          ],
          "description": "PLAIN: single SKU, no choices. VARIANT: one of several pre-defined options of a parent. WITH_EXTRAS: base item with optional add-ons. COMPOSED: base with mandatory and optional customisation groups. BUNDLE: composite of multiple component resources (see bundleComposition).\n",
          "example": "COMPOSED"
        },
        "menuCategory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/LocalisedText"
            },
            "sequence": {
              "type": "integer"
            },
            "imageUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "x-ion-conditional": true,
          "x-ion-condition": "Required for food and beverage providers"
        },
        "preparationTime": {
          "type": "string",
          "description": "ISO 8601 duration. Time from order confirm to item ready.",
          "example": "PT20M",
          "x-ion-conditional": true,
          "x-ion-condition": "Required for food, beverage and made-to-order items"
        },
        "regulatory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registrations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scheme": {
                    "type": "string",
                    "enum": [
                      "BPOM_MD",
                      "BPOM_ML",
                      "BPOM_TR",
                      "MUI_HALAL",
                      "SNI",
                      "SP_PIRT",
                      "KEMENKES",
                      "SIUP"
                    ]
                  },
                  "id": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "BRAND_OWNER",
                      "MANUFACTURER",
                      "IMPORTER",
                      "PACKER"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "validUntil": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "scheme",
                  "id"
                ]
              }
            },
            "foodRegulatoryDeclaration": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "nutritionalInfo": {
                  "type": "string",
                  "example": "Energi 350 kkal per 100g; Protein 10g; Lemak Total 5g"
                },
                "additivesInfo": {
                  "type": "string"
                },
                "ingredientsInfo": {
                  "type": "string"
                },
                "brandOwnerBpomLicenseNo": {
                  "type": "string"
                },
                "importerBpomLicenseNo": {
                  "type": "string"
                },
                "mfgLicenseNo": {
                  "type": "string"
                }
              }
            },
            "nutrition": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "nutrient": {
                    "type": "string",
                    "example": "Protein"
                  },
                  "value": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "unitCode",
                      "unitQuantity"
                    ],
                    "properties": {
                      "unitCode": {
                        "type": "string",
                        "enum": [
                          "G",
                          "MG",
                          "MCG",
                          "KCAL",
                          "KJ",
                          "IU",
                          "PERCENT"
                        ]
                      },
                      "unitQuantity": {
                        "type": "number"
                      }
                    }
                  }
                },
                "required": [
                  "nutrient",
                  "value"
                ]
              }
            },
            "additives": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "CONTAINS",
                      "FREE_FROM"
                    ]
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "credentials": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "issuer": {
                    "type": "string"
                  },
                  "validUntil": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "type",
                  "uri"
                ]
              }
            },
            "backImage": {
              "type": "string",
              "format": "uri",
              "description": "Back-of-pack statutory requirements image"
            }
          }
        },
        "food": {
          "description": "Packaged food product attributes for filtering and regulatory compliance. Use for FMCG packaged food, grocery products, bottled beverages, packaged meal kits, snacks, and confectionery sold from warehouse stock. Do not use for restaurant or cloud kitchen menu items — those use MenuItem in the Hospitality sector (hospitality/menu-item/v1). Detailed nutritional information and ingredient lists belong in Descriptor.longDesc for agent readability.",
          "allOf": [
            {
              "$ref": "https://schema.beckn.io/RetailResource/v2.1/attributes.yaml#/components/schemas/RetailResource/properties/food"
            },
            {
              "type": "object",
              "properties": {
                "classification": {
                  "$ref": "https://schema.beckn.io/RetailResource/v2.1/attributes.yaml#/components/schemas/RetailResource/properties/food/properties/classification"
                },
                "allergens": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "GLUTEN",
                      "NUTS",
                      "DAIRY",
                      "EGGS",
                      "SOY",
                      "SHELLFISH",
                      "FISH",
                      "SESAME",
                      "SULPHITES",
                      "CELERY",
                      "MUSTARD",
                      "LUPIN"
                    ]
                  }
                },
                "cuisineType": {
                  "type": "string",
                  "example": "Padang"
                },
                "spiceLevel": {
                  "type": "string",
                  "description": "Spiciness level of the food item. Free-text to accommodate regional descriptors (e.g. 'Pedas Sedang', 'Level 3', 'Extra Hot').",
                  "x-ion-suggested-values": [
                    "NONE",
                    "LOW",
                    "MEDIUM",
                    "HIGH",
                    "EXTRA_HOT"
                  ],
                  "example": "MEDIUM"
                },
                "freshProduce": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "netQuantityDeclaration": {
                      "allOf": [
                        {
                          "$ref": "https://schema.beckn.io/Quantity/2.0/attributes.yaml#/components/schemas/Quantity"
                        }
                      ],
                      "description": "Declared net quantity of the fresh produce.",
                      "example": {
                        "unitQuantity": 1,
                        "unitText": "kg"
                      }
                    },
                    "harvestDate": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                }
              }
            }
          ],
          "unevaluatedProperties": false,
          "x-ion-conditional": true,
          "x-ion-condition": "Required for food and beverage resources"
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instructions": {
              "type": "string",
              "example": "Panggang di oven 200°C selama 15 menit"
            },
            "storage": {
              "type": "string",
              "example": "Simpan di tempat sejuk dan kering"
            },
            "shelfLife": {
              "type": "string",
              "format": "duration",
              "description": "ISO 8601 duration",
              "example": "PT2H"
            }
          },
          "x-ion-conditional": true,
          "x-ion-condition": "Required for food, beverage and perishable products"
        },
        "fashion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gender": {
              "type": "string",
              "enum": [
                "MALE",
                "FEMALE",
                "UNISEX",
                "BOYS",
                "GIRLS"
              ]
            },
            "size": {
              "type": "string",
              "example": "L"
            },
            "sizeChart": {
              "type": "string",
              "format": "uri"
            },
            "fabric": {
              "type": "string",
              "example": "Katun"
            },
            "fabricComposition": {
              "type": "string",
              "example": "100% Katun",
              "x-ion-regulatory": "PerBSN SNI 0055:2009"
            }
          },
          "x-ion-conditional": true,
          "x-ion-condition": "Required for fashion and apparel products"
        },
        "electronics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storage": {
              "type": "integer"
            },
            "osType": {
              "type": "string",
              "enum": [
                "IOS",
                "ANDROID",
                "WINDOWS",
                "MACOS",
                "LINUX",
                "TIZEN",
                "WEBOS",
                "OTHER"
              ]
            },
            "connectivity": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "WIFI",
                  "BLUETOOTH",
                  "NFC",
                  "USB_C",
                  "USB_A",
                  "HDMI",
                  "ETHERNET",
                  "LIGHTNING",
                  "MMWAVE_5G",
                  "SUB6_5G",
                  "4G_LTE",
                  "3G",
                  "IR_BLASTER"
                ]
              }
            },
            "wattage": {
              "type": "integer",
              "description": "Power consumption watts"
            },
            "voltage": {
              "type": "string",
              "example": "220V"
            },
            "energyRating": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "BSN energy efficiency star rating"
            }
          },
          "x-ion-conditional": true,
          "x-ion-condition": "Required for electronics and appliance products"
        },
        "beauty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "conscious": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "NATURAL",
                  "ORGANIC",
                  "VEGAN",
                  "CRUELTY_FREE",
                  "HALAL_COSMETICS"
                ]
              }
            },
            "preference": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "HERBAL",
                  "AYURVEDIC",
                  "CHEMICAL_FREE",
                  "FRAGRANCE_FREE",
                  "ALCOHOL_FREE"
                ]
              }
            },
            "formulation": {
              "type": "string",
              "enum": [
                "LIQUID",
                "CREAM",
                "GEL",
                "POWDER",
                "SERUM",
                "BALM",
                "SPRAY",
                "FOAM",
                "STICK",
                "SHEET"
              ]
            },
            "skinType": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "ALL",
                  "NORMAL",
                  "OILY",
                  "DRY",
                  "COMBINATION",
                  "SENSITIVE"
                ]
              }
            },
            "hairType": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "ALL",
                  "NORMAL",
                  "OILY",
                  "DRY",
                  "DAMAGED",
                  "CURLY",
                  "STRAIGHT"
                ]
              }
            },
            "spf": {
              "type": "integer",
              "minimum": 1,
              "example": 50
            },
            "gender": {
              "type": "string",
              "enum": [
                "MALE",
                "FEMALE",
                "UNISEX"
              ]
            }
          },
          "x-ion-conditional": true,
          "x-ion-condition": "Required for beauty and personal care products"
        },
        "agritech": {
          "type": "object",
          "additionalProperties": false,
          "description": "Agricultural and fresh produce attributes. Covers harvest dates, produce grade, pesticide declarations, and unit of measure for weight-sold products. Represent organic certification through regulatory.credentials.",
          "properties": {
            "harvestDate": {
              "type": "string",
              "format": "date"
            },
            "produceGrade": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scheme",
                "value"
              ],
              "properties": {
                "scheme": {
                  "type": "string",
                  "description": "Grading standard or authority under which the grade is assigned."
                },
                "value": {
                  "type": "string",
                  "example": "GRADE_A"
                }
              }
            },
            "pesticideDeclaration": {
              "type": "string",
              "enum": [
                "PESTICIDE_FREE",
                "LOW_PESTICIDE",
                "STANDARD",
                "ORGANIC_CERTIFIED"
              ]
            },
            "unitOfMeasure": {
              "allOf": [
                {
                  "$ref": "https://schema.beckn.io/Quantity/2.0/attributes.yaml#/components/schemas/Quantity"
                },
                {
                  "type": "object",
                  "properties": {
                    "unitText": {
                      "$ref": "https://schema.beckn.io/Quantity/2.0/attributes.yaml#/components/schemas/Quantity/properties/unitText"
                    }
                  }
                }
              ],
              "description": "Declared net quantity of the fresh produce.",
              "example": {
                "unitQuantity": 1,
                "unitText": "kg"
              }
            }
          },
          "x-ion-conditional": true,
          "x-ion-condition": "Required for agritech and fresh produce"
        },
        "pharmacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prescriptionRequired": {
              "type": "boolean"
            },
            "dosageForm": {
              "type": "string",
              "description": "Pharmaceutical dosage form. Suggested values cover common forms; other values are permitted as pharmaceutical forms evolve.",
              "x-ion-suggested-values": [
                "TABLET",
                "CAPSULE",
                "SYRUP",
                "INJECTION",
                "OINTMENT",
                "DROPS",
                "INHALER",
                "SUPPOSITORY",
                "PATCH"
              ],
              "example": "TABLET"
            },
            "activeIngredients": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ingredient"
                ],
                "properties": {
                  "ingredient": {
                    "type": "string"
                  },
                  "strength": {
                    "allOf": [
                      {
                        "$ref": "https://schema.beckn.io/Quantity/2.0/attributes.yaml#/components/schemas/Quantity"
                      }
                    ],
                    "description": "Strength of this active ingredient."
                  }
                }
              }
            },
            "coldChainRequired": {
              "type": "boolean"
            }
          },
          "x-ion-regulatory": "PerBPOM Nomor 4 Tahun 2018",
          "x-ion-conditional": true,
          "x-ion-condition": "Required for pharmaceutical and OTC medicine"
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providedBySeller": {
              "type": "boolean"
            },
            "notes": {
              "type": "string",
              "example": "Memerlukan instalasi profesional. Membutuhkan arus 220V khusus."
            }
          },
          "x-ion-conditional": true,
          "x-ion-condition": "Required for appliances and furniture needing installation"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indoorOnly": {
              "type": "boolean"
            },
            "compatibleWith": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "220V outlet",
                "36-inch doorway"
              ]
            }
          }
        },
        "warranty": {
          "allOf": [
            {
              "$ref": "https://schema.beckn.io/RetailResource/v2.1/attributes.yaml#/components/schemas/RetailResource/properties/warranty"
            },
            {
              "type": "object",
              "properties": {
                "duration": {
                  "$ref": "https://schema.beckn.io/RetailResource/v2.1/attributes.yaml#/components/schemas/RetailResource/properties/warranty/properties/duration"
                },
                "terms": {
                  "$ref": "https://schema.beckn.io/RetailResource/v2.1/attributes.yaml#/components/schemas/RetailResource/properties/warranty/properties/terms"
                }
              }
            }
          ],
          "x-ion-regulatory": "UU 8/1999 tentang Perlindungan Konsumen Pasal 25; PP 36/2023",
          "x-ion-conditional": true,
          "x-ion-condition": "Required for electronics, appliances, consumer durables"
        },
        "ageRestricted": {
          "type": "boolean",
          "description": "Whether product requires age verification at purchase",
          "default": false
        },
        "regionOfOrigin": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[A-Z0-9]{1,3}$",
          "description": "ISO 3166-2 sub-national region code for geographic indication. Required when product claims origin-protected status (Kopi Gayo from Aceh IDN-AC, Beras Cianjur from West Java IDN-JB).\n",
          "example": "IDN-AC",
          "x-ion-regulatory": "UU 20/2016 tentang Merek dan Indikasi Geografis",
          "x-ion-conditional": true,
          "x-ion-condition": "Required when product claims Geographic Indication status"
        },
        "geographicIndicationCert": {
          "type": "string",
          "description": "Geographic Indication certificate number from DJKI (Direktorat Jenderal Kekayaan Intelektual).\n",
          "x-ion-conditional": true,
          "x-ion-condition": "Required when regionOfOrigin is declared for GI products"
        },
        "digital": {
          "type": "object",
          "additionalProperties": false,
          "description": "Digital goods attributes. Required for DIGITAL_VOUCHER, DIGITAL_TOP_UP, and DIGITAL_SUBSCRIPTION resource types.\n",
          "properties": {
            "digitalCategory": {
              "type": "string",
              "enum": [
                "MOBILE_PULSA",
                "MOBILE_DATA_PACKAGE",
                "ELECTRICITY_TOKEN",
                "WATER_BILL",
                "INTERNET_BILL",
                "PDAM_BILL",
                "PBB_TAX",
                "BPJS_PAYMENT",
                "GIFT_CARD",
                "GAME_VOUCHER",
                "STREAMING_VOUCHER",
                "FOOD_VOUCHER",
                "EWALLET_TOP_UP",
                "TRANSPORT_VOUCHER",
                "EDUCATION_VOUCHER",
                "OTHER"
              ],
              "description": "Type of digital good. MOBILE_PULSA/DATA covered by Indonesian operator regulations; GAME_VOUCHER includes Mobile Legends, Free Fire, Valorant, Genshin currencies; STREAMING_VOUCHER for Netflix/Disney+ Hotstar/Spotify access codes.\n"
            },
            "operatorOrIssuer": {
              "type": "string",
              "description": "Issuing operator or brand. For MOBILE_PULSA: TELKOMSEL, XL, INDOSAT, TRI, SMARTFREN. For ELECTRICITY_TOKEN: PLN. For GAME_VOUCHER: Moonton, Garena, Riot, etc.\n",
              "example": "TELKOMSEL"
            },
            "denomination": {
              "type": "object",
              "additionalProperties": false,
              "description": "Voucher/top-up denomination",
              "properties": {
                "value": {
                  "type": "number"
                },
                "currency": {
                  "type": "string",
                  "default": "IDR"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "IDR",
                    "MB",
                    "GB",
                    "MINUTES",
                    "DIAMONDS",
                    "COINS",
                    "OTHER"
                  ],
                  "description": "IDR for money-based; MB/GB for data; DIAMONDS/COINS for in-game"
                }
              },
              "required": [
                "value",
                "unit"
              ]
            },
            "deliveryMethod": {
              "type": "string",
              "enum": [
                "PUSH_TO_TARGET",
                "CODE_TO_BUYER",
                "ACCOUNT_CREDIT",
                "QR_VOUCHER"
              ],
              "description": "PUSH_TO_TARGET: delivered directly to consumer account (pulsa to phone number, PLN token to meter, in-game currency to game account). CODE_TO_BUYER: redemption code sent to buyer to redeem later. ACCOUNT_CREDIT: credited to buyer's wallet/account. QR_VOUCHER: scannable QR redeemable at merchant.\n"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "description": "Target identifier for delivery",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "MOBILE_NUMBER",
                    "CUSTOMER_ID",
                    "ACCOUNT_ID",
                    "EMAIL",
                    "METER_NUMBER",
                    "GAME_USER_ID"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "operatorValidationRequired": {
                  "type": "boolean",
                  "description": "Whether BPP must verify target exists before accepting (e.g. mobile number inquiry)"
                }
              }
            },
            "redemptionCode": {
              "type": "string",
              "description": "Redemption code or voucher code. Returned in on_status[DELIVERED] for CODE_TO_BUYER delivery. Must be encrypted in transit.\n"
            },
            "redemptionUrl": {
              "type": "string",
              "format": "uri",
              "description": "URL for redemption (streaming service activation, game code page)"
            },
            "expiryAfterPurchase": {
              "type": "string",
              "description": "ISO 8601 duration — how long the voucher is valid from purchase",
              "example": "P30D"
            },
            "refundable": {
              "type": "boolean",
              "default": false,
              "description": "Whether the digital good is refundable. Most pulsa/top-up is non-refundable once delivered to target. Vouchers may be refundable if unredeemed.\n"
            },
            "cancellable": {
              "type": "boolean",
              "default": false,
              "description": "Whether cancellation is possible before delivery"
            }
          },
          "x-ion-conditional": true,
          "x-ion-condition": "Required when resourceTangibility IN [DIGITAL_VOUCHER, DIGITAL_TOP_UP, DIGITAL_SUBSCRIPTION]"
        },
        "dataResidency": {
          "type": "string",
          "enum": [
            "DOMESTIC_ONLY",
            "INTERNATIONAL_ALLOWED"
          ],
          "description": "Data residency requirement for this resource. DOMESTIC_ONLY means all PII and transaction data must be processed and stored within Indonesia; BAPs with foreign data processing must skip or refuse transactions for this resource. Required for pharmacy, health data, financial services, and regulated biometric categories.\n",
          "example": "DOMESTIC_ONLY",
          "x-ion-regulatory": "UU 27/2022 tentang Pelindungan Data Pribadi (PDP Law)",
          "x-ion-conditional": true,
          "x-ion-condition": "Required for pharmacy, health-data, financial-services categories"
        }
      },
      "allOf": [
        {
          "$ref": "https://schema.beckn.io/Attributes/2.0/attributes.yaml#/components/schemas/Attributes"
        },
        {
          "if": {
