{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/trade/resource/v1",
  "title": "ION Trade Resource Extension (v1)",
  "description": "Entry point resolves to IONTradeResource. TradeResource is the generic base.",
  "$ref": "#/$defs/IONTradeResource",
  "$defs": {
    "LocalisedText": {
      "type": "object",
      "description": "Language-keyed text. \"id\" always required. \"en\" required for cross-border pattern.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "TradeResource": {
      "type": "object",
      "title": "TradeResource",
      "description": "Generic trade resource extension. Inherits RetailResource from schema.beckn.io. Network-specific deployments SHOULD extend this rather than using it directly.",
      "additionalProperties": true,
      "allOf": [
        {
          "$ref": "https://schema.beckn.io/RetailResource/v2.1/attributes.yaml#/components/schemas/RetailResource"
        },
        {
          "if": {
            "properties": {
              "resourceStructure": {
                "enum": [
                  "VARIANT"
                ]
              }
            },
            "required": [
              "resourceStructure"
            ]
          },
          "then": {
            "required": [
              "parentResourceId",
              "isDefaultVariant",
              "variantGroup"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resourceStructure": {
                "enum": [
                  "COMPOSED",
                  "WITH_EXTRAS"
                ]
              }
            },
            "required": [
              "resourceStructure"
            ]
          },
          "then": {
            "required": [
              "customisationGroups"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ageRestricted": {
                "const": true
              }
            },
            "required": [
              "ageRestricted"
            ]
          },
          "then": {
            "required": [
              "minAge"
            ]
          }
        }
      ],
      "properties": {
        "resourceStructure": {
          "type": "string",
          "enum": [
            "PLAIN",
            "VARIANT",
            "WITH_EXTRAS",
            "COMPOSED",
            "BUNDLE"
          ]
        },
        "resourceTangibility": {
          "type": "string",
          "enum": [
            "PHYSICAL",
            "DIGITAL_VOUCHER",
            "DIGITAL_TOP_UP",
            "DIGITAL_SUBSCRIPTION"
          ]
        },
        "parentResourceId": {
          "type": "string"
        },
        "isDefaultVariant": {
          "type": "boolean"
        },
        "variantGroup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "variantOn"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/LocalisedText"
            },
            "variantOn": {
              "type": "string"
            }
          }
        },
        "variantMatrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "axes",
            "combinationRules"
          ],
          "properties": {
            "axes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "values"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "$ref": "#/$defs/LocalisedText"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "$ref": "#/$defs/LocalisedText"
                        },
                        "priceDelta": {
                          "type": "number"
                        },
                        "available": {
                          "type": "boolean",
                          "default": true
                        },
                        "resourceIdOverride": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "combinationRules": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "generateAllCombinations"
              ],
              "properties": {
                "generateAllCombinations": {
                  "type": "boolean"
                },
                "explicitCombinations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "axisValues",
                      "priceValue"
                    ],
                    "properties": {
                      "axisValues": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "priceValue": {
                        "type": "number"
                      },
                      "available": {
                        "type": "boolean",
                        "default": true
                      }
                    }
                  }
                },
                "priceCalculationMode": {
                  "type": "string",
                  "enum": [
                    "SUM_AXIS_DELTAS",
                    "EXPLICIT_PRICE"
                  ],
                  "default": "SUM_AXIS_DELTAS"
                }
              }
            }
          }
        },
        "customisationGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "selectionType",
              "options"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "$ref": "#/$defs/LocalisedText"
              },
              "selectionType": {
                "type": "string",
                "enum": [
                  "SINGLE_REQUIRED",
                  "SINGLE_OPTIONAL",
                  "MULTIPLE_OPTIONAL",
                  "FIXED"
                ]
              },
              "minSelections": {
                "type": "integer",
                "minimum": 0
              },
              "maxSelections": {
                "type": "integer",
                "minimum": 1
              },
              "sequence": {
                "type": "integer"
              },
              "inputType": {
                "type": "string",
                "enum": [
                  "select",
                  "text",
                  "number",
                  "date",
                  "boolean"
                ],
                "default": "select"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "$ref": "#/$defs/LocalisedText"
                    },
                    "resourceId": {
                      "type": "string"
                    },
                    "priceDelta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "FIXED",
                            "PERCENT"
                          ]
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    },
                    "available": {
                      "type": "boolean",
                      "default": true
                    }
                  }
                }
              }
            }
          }
        },
        "menuCategory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/LocalisedText"
            },
            "sequence": {
              "type": "integer"
            },
            "imageUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "preparationTime": {
          "type": "string"
        },
        "productCode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "GTIN",
                "EAN",
                "UPC",
                "ISBN",
                "ASIN",
                "HSN",
                "ION_SKU"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "itemRating": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "logisticsServiceType": {
          "type": "string",
          "enum": [
            "DOMESTIC_SURFACE",
            "DOMESTIC_AIR",
            "HYPERLOCAL",
            "INTERNATIONAL_AIR",
            "INTERNATIONAL_OCEAN"
          ]
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "IN_STOCK",
                "LOW_STOCK",
                "OUT_OF_STOCK",
                "PREORDER",
                "DISCONTINUED"
              ]
            },
            "nextAvailableAt": {
              "type": "string",
              "format": "date-time"
            },
            "maxOrderQty": {
              "type": "integer",
              "minimum": 1
            },
            "backorderAllowed": {
              "type": "boolean",
              "default": false
            },
            "preorderAllowed": {
              "type": "boolean",
              "default": false
            },
            "substitutionAllowed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "brand": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "modelYear": {
              "type": "integer"
            },
            "sku": {
              "type": "string"
            }
          }
        },
        "physical": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "color": {
              "type": "string"
            },
            "colorName": {
              "type": "string"
            },
            "dimensions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "unit": {
                  "type": "string",
                  "enum": [
                    "MM",
                    "CM",
                    "M",
                    "IN",
                    "FT"
                  ],
                  "default": "CM"
                },
                "length": {
                  "type": "number",
                  "minimum": 0
                },
                "breadth": {
                  "type": "number",
                  "minimum": 0
                },
                "height": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "weight": {
              "description": "Shipping weight of the item.",
              "allOf": [
                {
                  "$ref": "https://schema.beckn.io/Quantity/2.0#/components/schemas/Quantity"
                }
              ]
            }
          }
        },
        "packaged": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "netQuantity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "GRAM",
                    "KILOGRAM",
                    "MILLILITRE",
                    "LITRE",
                    "PIECE",
                    "DOZEN",
                    "METER",
                    "CENTIMETER"
                  ]
                }
              }
            },
            "manufacturerOrPacker": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "name",
                "address"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "MANUFACTURER",
                    "PACKER",
                    "IMPORTER"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                }
              }
            },
            "manufacturePackingImportDate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "year": {
                  "type": "integer",
                  "minimum": 2000
                }
              }
            },
            "monthYearOfManufacture": {
              "type": "string",
              "pattern": "^[0-9]{2}/[0-9]{4}$"
            },
            "expiryDate": {
              "type": "string",
              "format": "date"
            },
            "commonOrGenericName": {
              "type": "string"
            }
          }
        },
        "regulatory": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "registrations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scheme",
                  "id"
                ],
                "properties": {
                  "scheme": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "BRAND_OWNER",
                      "MANUFACTURER",
                      "IMPORTER",
                      "PACKER"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "validUntil": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            },
            "foodRegulatoryDeclaration": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "nutritionalInfo": {
                  "type": "string"
                },
                "additivesInfo": {
                  "type": "string"
                },
                "ingredientsInfo": {
                  "type": "string"
                }
              }
            },
            "nutrition": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nutrient",
                  "value"
                ],
                "properties": {
                  "nutrient": {
                    "type": "string"
                  },
                  "value": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "unitCode",
                      "unitQuantity"
                    ],
                    "properties": {
                      "unitCode": {
                        "type": "string",
                        "enum": [
                          "G",
                          "MG",
                          "MCG",
                          "KCAL",
                          "KJ",
                          "IU",
                          "PERCENT"
                        ]
                      },
                      "unitQuantity": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "additives": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "CONTAINS",
                      "FREE_FROM"
                    ]
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "credentials": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "uri"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "issuer": {
                    "type": "string"
                  },
                  "validUntil": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            },
            "backImage": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "food": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "classification": {
              "type": "string",
              "enum": [
                "VEG",
                "NON_VEG",
                "HALAL",
                "EGG"
              ]
            },
            "allergens": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "GLUTEN",
                  "NUTS",
                  "DAIRY",
                  "EGGS",
                  "SOY",
                  "SHELLFISH",
                  "FISH",
                  "SESAME",
                  "SULPHITES",
                  "CELERY",
                  "MUSTARD",
                  "LUPIN"
                ]
              }
            },
            "cuisineType": {
              "type": "string"
            },
            "spiceLevel": {
              "type": "string",
              "enum": [
                "NONE",
                "LOW",
                "MEDIUM",
                "HIGH",
                "EXTRA_HOT"
              ]
            },
            "freshProduce": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "netQuantityDeclaration": {
                  "type": "string"
                },
                "harvestDate": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instructions": {
              "type": "string"
            },
            "storage": {
              "type": "string"
            },
            "shelfLife": {
              "type": "string"
            }
          }
        },
        "fashion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gender": {
              "type": "string",
              "enum": [
                "MALE",
                "FEMALE",
                "UNISEX",
                "BOYS",
                "GIRLS"
              ]
            },
            "size": {
              "type": "string"
            },
            "sizeChart": {
              "type": "string",
              "format": "uri"
            },
            "fabric": {
              "type": "string"
            },
            "fabricComposition": {
              "type": "string"
            },
            "fitType": {
              "type": "string",
              "enum": [
                "SLIM",
                "REGULAR",
                "OVERSIZED",
                "RELAXED",
                "ATHLETIC"
              ]
            },
            "sleeveType": {
              "type": "string",
              "enum": [
                "SLEEVELESS",
                "SHORT",
                "THREE_QUARTER",
                "FULL",
                "NONE"
              ]
            },
            "collarType": {
              "type": "string",
              "enum": [
                "ROUND",
                "V_NECK",
                "POLO",
                "SPREAD",
                "MANDARIN",
                "HOODIE",
                "NONE"
              ]
            },
            "occasion": {
              "type": "string",
              "enum": [
                "CASUAL",
                "FORMAL",
                "ETHNIC",
                "SPORTS",
                "PARTY",
                "BEACH",
                "WORKWEAR"
              ]
            },
            "pattern": {
              "type": "string",
              "enum": [
                "SOLID",
                "PRINTED",
                "STRIPED",
                "CHECKED",
                "EMBROIDERED",
                "TIE_DYE",
                "BATIK"
              ]
            },
            "careInstructions": {
              "type": "string"
            }
          }
        },
        "electronics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ram": { "type": "integer" },
            "ramUnit": { "type": "string", "enum": ["MB", "GB"], "default": "GB" },
            "rom": { "type": "integer" },
            "romUnit": { "type": "string", "enum": ["MB", "GB", "TB"], "default": "GB" },
            "storage": { "type": "integer" },
            "storageUnit": { "type": "string", "enum": ["MB", "GB", "TB"], "default": "GB" },
            "storageCapacity": { "type": "integer" },
            "storageCapacityUnit": { "type": "string", "enum": ["LITRE", "KG", "CUBIC_FEET"] },
            "screenSize": { "type": "number" },
            "primaryCamera": { "type": "integer" },
            "secondaryCamera": { "type": "integer" },
            "cpu": { "type": "string" },
            "gpu": { "type": "string" },
            "batteryCapacity": { "type": "integer" },
            "osType": {
              "type": "string",
              "enum": ["IOS", "ANDROID", "WINDOWS", "MACOS", "LINUX", "TIZEN", "WEBOS", "OTHER"]
            },
            "osVersion": { "type": "string" },
            "connectivity": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "WIFI", "BLUETOOTH", "NFC", "USB_C", "USB_A", "HDMI", "ETHERNET",
                  "LIGHTNING", "MMWAVE_5G", "SUB6_5G", "4G_LTE", "3G", "IR_BLASTER"
                ]
              }
            },
            "wattage": { "type": "integer" },
            "voltage": { "type": "string" },
            "energyRating": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "beauty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "conscious": {
              "type": "string",
              "enum": ["NATURAL", "ORGANIC", "VEGAN", "CRUELTY_FREE", "HALAL_COSMETICS"]
            },
            "preference": {
              "type": "string",
              "enum": ["HERBAL", "AYURVEDIC", "CHEMICAL_FREE", "FRAGRANCE_FREE", "ALCOHOL_FREE"]
            },
            "formulation": {
              "type": "string",
              "enum": ["LIQUID", "CREAM", "GEL", "POWDER", "SERUM", "BALM", "SPRAY", "FOAM", "STICK", "SHEET"]
            },
            "skinType": {
              "type": "string",
              "enum": ["ALL", "NORMAL", "OILY", "DRY", "COMBINATION", "SENSITIVE"]
            },
            "hairType": {
              "type": "string",
              "enum": ["ALL", "NORMAL", "OILY", "DRY", "DAMAGED", "CURLY", "STRAIGHT"]
            },
            "spf": { "type": "integer", "minimum": 0 },
            "gender": { "type": "string", "enum": ["MALE", "FEMALE", "UNISEX"] },
            "volume": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": { "type": "number" },
                "unit": { "type": "string", "enum": ["ML", "G", "OZ"] }
              }
            }
          }
        },
        "agritech": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "harvestDate": { "type": "string", "format": "date" },
            "produceGrade": {
              "type": "string",
              "enum": ["PREMIUM", "GRADE_A", "GRADE_B", "GRADE_C"]
            },
            "pesticideDeclaration": {
              "type": "string",
              "enum": ["PESTICIDE_FREE", "LOW_PESTICIDE", "STANDARD", "ORGANIC_CERTIFIED"]
            },
            "organicCertification": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "certBody": { "type": "string" },
                "certNumber": { "type": "string" }
              }
            },
            "unitOfMeasure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unit", "value"],
              "properties": {
                "unit": {
                  "type": "string",
                  "enum": ["GRAM", "KILOGRAM", "LITRE", "MILLILITRE", "PIECE", "DOZEN", "BUNCH", "IKAT"]
                },
                "value": { "type": "number" }
              }
            }
          }
        },
        "pharmacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prescriptionRequired": { "type": "boolean" },
            "dosageForm": {
              "type": "string",
              "enum": ["TABLET", "CAPSULE", "SYRUP", "INJECTION", "OINTMENT", "DROPS", "INHALER", "SUPPOSITORY", "PATCH"]
            },
            "strength": { "type": "string" },
            "activeIngredients": { "type": "array", "items": { "type": "string" } },
            "coldChainRequired": { "type": "boolean" }
          }
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providedBySeller": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indoorOnly": { "type": "boolean" },
            "compatibleWith": { "type": "array", "items": { "type": "string" } }
          }
        },
        "warranty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duration": { "type": "string" },
            "type": { "type": "string", "enum": ["MANUFACTURER", "SELLER", "EXTENDED", "NONE"] },
            "terms": { "type": "string" },
            "serviceCenter": { "type": "string" }
          }
        },
        "ageRestricted": {
          "type": "boolean",
          "default": false
        },
        "minAge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21
        },
        "countryOfOrigin": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "canonicalId": {
          "type": "string"
        },
        "featuredOfferEligible": {
          "type": "boolean",
          "default": false
        },
        "featuredOfferScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "imageSet": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "role"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "role": {
                "type": "string",
                "enum": [
                  "PRIMARY", "GALLERY", "SIZE_CHART", "SPEC_SHEET", "LIFESTYLE",
                  "UNBOXING", "SIZE_FIT", "USE_IN_CONTEXT", "PACKAGING",
                  "BACK_OF_PACK", "INGREDIENTS_LABEL", "NUTRITION_FACTS"
                ]
              },
              "altText": { "$ref": "#/$defs/LocalisedText" },
              "sequence": { "type": "integer" },
              "widthPx": { "type": "integer" },
              "heightPx": { "type": "integer" }
            }
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "role"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "role": {
                "type": "string",
                "enum": ["PRIMARY", "UNBOXING", "USE_IN_CONTEXT", "SIZE_FIT", "INSTALLATION_GUIDE", "360_VIEW", "LIVE_REPLAY"]
              },
              "durationSeconds": { "type": "integer" },
              "thumbnailUrl": { "type": "string", "format": "uri" }
            }
          }
        },
        "bundleComposition": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["componentResourceId", "quantity"],
            "properties": {
              "componentResourceId": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "individualWarrantyDuration": { "type": "string" },
              "componentPrice": { "type": "number" }
            }
          }
        },
        "brandIdentity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "brandOwnerLegalEntity": { "type": "string" },
            "brandCertificationId": { "type": "string" },
            "officialStoreStatus": { "type": "boolean" },
            "authorisedResellerOf": { "type": "array", "items": { "type": "string" } }
          }
        },
        "digital": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "digitalCategory": { "type": "string" },
            "operatorOrIssuer": { "type": "string" },
            "denomination": {
              "type": "object",
              "additionalProperties": true,
              "required": ["value", "unit"],
              "properties": {
                "value": { "type": "number" },
                "unit": { "type": "string" }
              }
            },
            "deliveryMethod": {
              "type": "string",
              "enum": ["PUSH_TO_TARGET", "CODE_TO_BUYER", "ACCOUNT_CREDIT", "QR_VOUCHER"]
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["MOBILE_NUMBER", "CUSTOMER_ID", "ACCOUNT_ID", "EMAIL", "METER_NUMBER", "GAME_USER_ID"]
                },
                "value": { "type": "string" },
                "operatorValidationRequired": { "type": "boolean" }
              }
            },
            "redemptionCode": { "type": "string" },
            "redemptionUrl": { "type": "string", "format": "uri" },
            "expiryAfterPurchase": { "type": "string" },
            "refundable": { "type": "boolean", "default": false },
            "cancellable": { "type": "boolean", "default": false }
          }
        }
      },
      "required": [
        "resourceStructure",
        "resourceTangibility",
        "images",
        "logisticsServiceType",
        "availability",
        "ageRestricted",
        "countryOfOrigin"
      ]
    },
    "IONTradeResource": {
      "type": "object",
      "title": "IONTradeResource",
      "description": "ION Network (Indonesia) trade resource extension. Extends TradeResource with Indonesia-specific regulatory, geographic indication, and digital goods fields.",
      "additionalProperties": true,
      "allOf": [
        {
          "$ref": "#/$defs/TradeResource"
        },
        {
          "type": "object",
          "properties": {
            "dataResidency": {
              "type": "string",
              "enum": ["DOMESTIC_ONLY", "INTERNATIONAL_ALLOWED"]
            },
            "regionOfOrigin": {
              "type": "string",
              "pattern": "^[A-Z]{3}-[A-Z0-9]{1,3}$"
            },
            "geographicIndicationCert": {
              "type": "string"
            },
            "packaged": {
              "type": "object",
              "properties": {
                "hsnCode": { "type": "string" }
              }
            },
            "regulatory": {
              "type": "object",
              "properties": {
                "registrations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "scheme": {
                        "type": "string",
                        "enum": [
                          "BPOM_MD", "BPOM_ML", "BPOM_TR",
                          "MUI_HALAL", "SNI", "SP_PIRT",
                          "KEMENKES", "SIUP"
                        ]
                      }
                    }
                  }
                },
                "foodRegulatoryDeclaration": {
                  "type": "object",
                  "properties": {
                    "brandOwnerBpomLicenseNo": { "type": "string" },
                    "importerBpomLicenseNo": { "type": "string" },
                    "mfgLicenseNo": { "type": "string" }
                  }
                }
              }
            },
            "agritech": {
              "type": "object",
              "properties": {
                "mandiReferencePrice": { "type": "number" }
              }
            },
            "digital": {
              "type": "object",
              "properties": {
                "digitalCategory": {
                  "type": "string",
                  "enum": [
                    "MOBILE_PULSA", "MOBILE_DATA_PACKAGE", "ELECTRICITY_TOKEN",
                    "WATER_BILL", "INTERNET_BILL", "PDAM_BILL", "PBB_TAX",
                    "BPJS_PAYMENT", "GIFT_CARD", "GAME_VOUCHER", "STREAMING_VOUCHER",
                    "FOOD_VOUCHER", "EWALLET_TOP_UP", "TRANSPORT_VOUCHER",
                    "EDUCATION_VOUCHER", "OTHER"
                  ]
                },
                "denomination": {
                  "type": "object",
                  "properties": {
                    "currency": { "type": "string", "default": "IDR" },
                    "unit": {
                      "type": "string",
                      "enum": ["IDR", "MB", "GB", "MINUTES", "DIAMONDS", "COINS", "OTHER"]
                    }
                  }
                }
              }
            },
            "bundleComposition": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "individualBpomReg": { "type": "string" },
                  "individualPostelReg": { "type": "string" }
                }
              }
            }
          }
        }
      ],
      "required": [
        "resourceStructure",
        "resourceTangibility",
        "images",
        "logisticsServiceType",
        "availability",
        "ageRestricted",
        "countryOfOrigin"
      ]
    }
  }
}
