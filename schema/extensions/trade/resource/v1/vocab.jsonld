{
  "@context": {
    "ion": "https://schema.ion.id/trade/resource/v1#",
    "retail": "https://schema.beckn.io/RetailResource/v2.1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
  },
  "@graph": [
    {
      "@id": "ion:LocalisedText",
      "@type": "rdfs:Class",
      "rdfs:label": "LocalisedText",
      "rdfs:comment": "Language-keyed text. \"id\" always required. \"en\" required for XB pattern.",
      "rdfs:subClassOf": {
        "@id": "retail:RetailResource"
      }
    },
    {
      "@id": "ion:id",
      "@type": "rdf:Property",
      "rdfs:label": "id",
      "rdfs:comment": "Axis identifier (size, color, storage, model, etc.)"
    },
    {
      "@id": "ion:en",
      "@type": "rdf:Property",
      "rdfs:label": "en",
      "rdfs:comment": "English text for cross-border pattern"
    },
    {
      "@id": "ion:TradeResource",
      "@type": "rdfs:Class",
      "rdfs:label": "TradeResource",
      "rdfs:comment": "Generic trade resource extension. Inherits RetailResource from schema.beckn.io.",
      "rdfs:subClassOf": {
        "@id": "retail:RetailResource"
      }
    },
    {
      "@id": "ion:IONTradeResource",
      "@type": "rdfs:Class",
      "rdfs:label": "IONTradeResource",
      "rdfs:comment": "ION Network (Indonesia) trade resource extension. Adds Indonesia-specific regulatory and digital goods fields.",
      "rdfs:subClassOf": {
        "@id": "ion:TradeResource"
      }
    },
    {
      "@id": "ion:resourceStructure",
      "@type": "rdf:Property",
      "rdfs:label": "resourceStructure",
      "rdfs:comment": "PLAIN: single SKU, no choices. VARIANT: one of several pre-defined options of a parent. WITH_EXTRAS: base item with optional add-ons. COMPOSED: base with mandatory and optional customisation groups. BUNDLE: composite of multiple component resources (see bundleComposition).\n"
    },
    {
      "@id": "ion:resourceTangibility",
      "@type": "rdf:Property",
      "rdfs:label": "resourceTangibility",
      "rdfs:comment": "PHYSICAL: tangible goods requiring logistics fulfilment. DIGITAL_VOUCHER: voucher code, gift card, in-game currency (delivered electronically). DIGITAL_TOP_UP: mobile top-up, data package, utility bill top-up. DIGITAL_SUBSCRIPTION: time-bound digital subscription access.\n"
    },
    {
      "@id": "ion:parentResourceId",
      "@type": "rdf:Property",
      "rdfs:label": "parentResourceId",
      "rdfs:comment": "ID of parent resource. Present on VARIANT and WITH_EXTRAS."
    },
    {
      "@id": "ion:isDefaultVariant",
      "@type": "rdf:Property",
      "rdfs:label": "isDefaultVariant",
      "rdfs:comment": "Whether this is the default variant shown to consumer."
    },
    {
      "@id": "ion:variantGroup",
      "@type": "rdf:Property",
      "rdfs:label": "variantGroup",
      "rdfs:comment": "The attribute that varies. e.g. size, colour, storage"
    },
    {
      "@id": "ion:variantMatrix",
      "@type": "rdf:Property",
      "rdfs:label": "variantMatrix",
      "rdfs:comment": "Multi-axis variant declaration. Use instead of explicit VARIANT resources when combinations are derivable. BPP MUST resolve the specific variant at on_select and compute final price via priceDeltaByCombination or per-axis priceDelta. Only valid on parent resources with resourceStructure=PLAIN; child VARIANT resources are not needed when this is declared."
    },
    {
      "@id": "ion:customisationGroups",
      "@type": "rdf:Property",
      "rdfs:label": "customisationGroups",
      "rdfs:comment": "Customisation group definitions for COMPOSED and WITH_EXTRAS resources."
    },
    {
      "@id": "ion:menuCategory",
      "@type": "rdf:Property",
      "rdfs:label": "menuCategory",
      "rdfs:comment": "Menu category for food and beverage providers."
    },
    {
      "@id": "ion:preparationTime",
      "@type": "rdf:Property",
      "rdfs:label": "preparationTime",
      "rdfs:comment": "ISO 8601 duration. Time from order confirm to item ready."
    },
    {
      "@id": "ion:productCode",
      "@type": "rdf:Property",
      "rdfs:label": "productCode",
      "rdfs:comment": "Structured product code (GTIN, EAN, UPC, ISBN, ASIN, HSN, ION_SKU)."
    },
    {
      "@id": "ion:images",
      "@type": "rdf:Property",
      "rdfs:label": "images",
      "rdfs:comment": "First image is primary thumbnail. Additional images for gallery."
    },
    {
      "@id": "ion:itemRating",
      "@type": "rdf:Property",
      "rdfs:label": "itemRating",
      "rdfs:comment": "Aggregate seller-maintained rating 1-5. Base items only."
    },
    {
      "@id": "ion:logisticsServiceType",
      "@type": "rdf:Property",
      "rdfs:label": "logisticsServiceType",
      "rdfs:comment": "Logistics service type. Determines flow and performance states."
    },
    {
      "@id": "ion:availability",
      "@type": "rdf:Property",
      "rdfs:label": "availability",
      "rdfs:comment": "IN_STOCK: adequate quantity available. LOW_STOCK: limited — BAP may show urgency signal."
    },
    {
      "@id": "ion:identity",
      "@type": "rdf:Property",
      "rdfs:label": "identity",
      "rdfs:comment": "Brand, model, model year, and seller internal SKU."
    },
    {
      "@id": "ion:physical",
      "@type": "rdf:Property",
      "rdfs:label": "physical",
      "rdfs:comment": "Physical attributes: color, dimensions, weight."
    },
    {
      "@id": "ion:packaged",
      "@type": "rdf:Property",
      "rdfs:label": "packaged",
      "rdfs:comment": "Required for food, beverage, pharma, cosmetics"
    },
    {
      "@id": "ion:regulatory",
      "@type": "rdf:Property",
      "rdfs:label": "regulatory",
      "rdfs:comment": "Regulatory registrations, food declarations, nutritional data, credentials."
    },
    {
      "@id": "ion:food",
      "@type": "rdf:Property",
      "rdfs:label": "food",
      "rdfs:comment": "Packaged food product attributes: classification, allergens, cuisine, spice level."
    },
    {
      "@id": "ion:preparation",
      "@type": "rdf:Property",
      "rdfs:label": "preparation",
      "rdfs:comment": "Preparation and storage instructions, shelf life."
    },
    {
      "@id": "ion:fashion",
      "@type": "rdf:Property",
      "rdfs:label": "fashion",
      "rdfs:comment": "Fashion and apparel attributes."
    },
    {
      "@id": "ion:electronics",
      "@type": "rdf:Property",
      "rdfs:label": "electronics",
      "rdfs:comment": "Consumer electronics technical specifications."
    },
    {
      "@id": "ion:beauty",
      "@type": "rdf:Property",
      "rdfs:label": "beauty",
      "rdfs:comment": "Beauty and personal care product attributes."
    },
    {
      "@id": "ion:agritech",
      "@type": "rdf:Property",
      "rdfs:label": "agritech",
      "rdfs:comment": "Agritech and fresh produce attributes."
    },
    {
      "@id": "ion:pharmacy",
      "@type": "rdf:Property",
      "rdfs:label": "pharmacy",
      "rdfs:comment": "Pharmaceutical and OTC medicine attributes."
    },
    {
      "@id": "ion:installation",
      "@type": "rdf:Property",
      "rdfs:label": "installation",
      "rdfs:comment": "Installation service details."
    },
    {
      "@id": "ion:usage",
      "@type": "rdf:Property",
      "rdfs:label": "usage",
      "rdfs:comment": "Usage constraints and compatibility."
    },
    {
      "@id": "ion:warranty",
      "@type": "rdf:Property",
      "rdfs:label": "warranty",
      "rdfs:comment": "ISO 8601 duration. Minimum P1Y for electronics."
    },
    {
      "@id": "ion:ageRestricted",
      "@type": "rdf:Property",
      "rdfs:label": "ageRestricted",
      "rdfs:comment": "Whether product requires age verification at purchase"
    },
    {
      "@id": "ion:minAge",
      "@type": "rdf:Property",
      "rdfs:label": "minAge",
      "rdfs:comment": "Minimum purchaser age when ageRestricted is true"
    },
    {
      "@id": "ion:countryOfOrigin",
      "@type": "rdf:Property",
      "rdfs:label": "countryOfOrigin",
      "rdfs:comment": "ISO 3166-1 alpha-3 country code"
    },
    {
      "@id": "ion:canonicalId",
      "@type": "rdf:Property",
      "rdfs:label": "canonicalId",
      "rdfs:comment": "Cross-provider product identity. Multiple providers selling the same product share the same canonicalId. Enables Buy Box selection on BAP side and cross-seller price comparison. GTIN preferred when available; otherwise network-assigned canonical ID.\n"
    },
    {
      "@id": "ion:featuredOfferEligible",
      "@type": "rdf:Property",
      "rdfs:label": "featuredOfferEligible",
      "rdfs:comment": "Whether this offer is eligible for \"featured offer\" / Buy Box selection. BPP declares eligibility; BAP runs selection algorithm.\n"
    },
    {
      "@id": "ion:featuredOfferScore",
      "@type": "rdf:Property",
      "rdfs:label": "featuredOfferScore",
      "rdfs:comment": "BPP-computed score used by BAP Buy Box algorithm. Decimal 0-1.\n"
    },
    {
      "@id": "ion:imageSet",
      "@type": "rdf:Property",
      "rdfs:label": "imageSet",
      "rdfs:comment": "Structured images with role metadata. More expressive than the flat images[] array.\n"
    },
    {
      "@id": "ion:videos",
      "@type": "rdf:Property",
      "rdfs:label": "videos",
      "rdfs:comment": "Video assets with role metadata."
    },
    {
      "@id": "ion:bundleComposition",
      "@type": "rdf:Property",
      "rdfs:label": "bundleComposition",
      "rdfs:comment": "Components of a bundle SKU. Required for bundle offers where individual components carry their own regulatory registrations or warranties.\n"
    },
    {
      "@id": "ion:brandIdentity",
      "@type": "rdf:Property",
      "rdfs:label": "brandIdentity",
      "rdfs:comment": "Structured brand identity. Replaces string-only identity.brand for Official Store / Brand Registry programmes.\n"
    },
    {
      "@id": "ion:regionOfOrigin",
      "@type": "rdf:Property",
      "rdfs:label": "regionOfOrigin",
      "rdfs:comment": "ISO 3166-2 sub-national region code for geographic indication. Required when product claims origin-protected status.\n"
    },
    {
      "@id": "ion:geographicIndicationCert",
      "@type": "rdf:Property",
      "rdfs:label": "geographicIndicationCert",
      "rdfs:comment": "Geographic Indication certificate number from DJKI (Direktorat Jenderal Kekayaan Intelektual).\n"
    },
    {
      "@id": "ion:digital",
      "@type": "rdf:Property",
      "rdfs:label": "digital",
      "rdfs:comment": "Digital goods attributes. Required for DIGITAL_VOUCHER, DIGITAL_TOP_UP, and DIGITAL_SUBSCRIPTION resource types.\n"
    },
    {
      "@id": "ion:dataResidency",
      "@type": "rdf:Property",
      "rdfs:label": "dataResidency",
      "rdfs:comment": "Data residency requirement for this resource. DOMESTIC_ONLY means all PII and transaction data must be processed and stored within Indonesia."
    }
  ]
}
