{
  "@context": {
    "ion": "https://schema.ion.id/trade/commitment/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "beckn": "https://spec.beckn.io/vocab/v2.0.0#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:TradeCommitment",
      "@type": "rdfs:Class",
      "rdfs:label": "TradeCommitment",
      "rdfs:comment": "Network-agnostic generic layer for TradeCommitment. Inherits from Beckn core Attributes.",
      "rdfs:subClassOf": {
        "@id": "beckn:Commitment"
      },
      "skos:broader": {
        "@id": "https://spec.beckn.io/vocab/v2.0.0#Commitment"
      }
    },
    {
      "@id": "ion:IONTradeCommitment",
      "@type": "rdfs:Class",
      "rdfs:label": "IONTradeCommitment",
      "rdfs:comment": "IONTradeCommitment",
      "rdfs:subClassOf": {
        "@id": "ion:TradeCommitment"
      },
      "skos:broader": {
        "@id": "https://spec.beckn.io/vocab/v2.0.0#Commitment"
      }
    },
    {
      "@id": "ion:groupId",
      "@type": "rdf:Property",
      "rdfs:label": "groupId",
      "rdfs:comment": "ID of the customisationGroup selected"
    },
    {
      "@id": "ion:optionId",
      "@type": "rdf:Property",
      "rdfs:label": "optionId",
      "rdfs:comment": "ID of the option selected within the group"
    },
    {
      "@id": "ion:customisationSelections",
      "@type": "rdf:Property",
      "rdfs:label": "customisationSelections",
      "rdfs:comment": "Buyer's selections from customisationGroups for COMPOSED and WITH_EXTRAS resources. One entry per group selected.\n"
    },
    {
      "@id": "ion:priceDelta",
      "@type": "rdf:Property",
      "rdfs:label": "priceDelta",
      "rdfs:comment": "Price delta applied by this selection."
    },
    {
      "@id": "ion:type",
      "@type": "rdf:Property",
      "rdfs:label": "type",
      "rdfs:comment": "Price delta type: FIXED or PERCENT."
    },
    {
      "@id": "ion:value",
      "@type": "rdf:Property",
      "rdfs:label": "value",
      "rdfs:comment": "Numeric value of the price delta."
    }
  ]
}
