{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/trade/commitment/v1",
  "title": "ION Trade Commitment Schema Pack v1",
  "description": "JSON Schema 2020-12 mirror of the trade/commitment/v1 OpenAPI schema pack. The root resolves to IONTradeCommitment; TradeCommitment provides the network-agnostic layer inherited from RetailCommitment v2.1.",
  "type": "object",
  "$ref": "#/$defs/IONTradeCommitment",
  "$defs": {
    "TradeCommitment": {
      "type": "object",
      "title": "TradeCommitment",
      "description": "Network-agnostic generic layer for TradeCommitment. Inherits RetailCommitment v2.1 and carries no Indonesia-specific regulatory or compliance fields.",
      "x-ion-layer": "generic",
      "x-ion-split-version": "0.7.0",
      "x-recommended-parent": "Commitment.commitmentAttributes",
      "additionalProperties": true,
      "allOf": [
        {
          "$ref": "https://schema.beckn.io/RetailCommitment/v2.1/attributes.yaml#/components/schemas/RetailCommitment"
        }
      ]
    },
    "IONTradeCommitment": {
      "type": "object",
      "title": "IONTradeCommitment",
      "description": "ION-specific extension of TradeCommitment.",
      "x-ion-layer": "ion",
      "x-ion-split-version": "0.7.0",
      "allOf": [
        {
          "$ref": "#/$defs/TradeCommitment"
        }
      ],
      "additionalProperties": true,
      "x-jsonld": {
        "@context": "https://schema.ion.id/trade/commitment/v1/context.jsonld",
        "@type": "ion:IONTradeCommitment"
      },
      "x-beckn-attaches-to": "Commitment.commitmentAttributes",
      "properties": {
        "customisationSelections": {
          "type": "array",
          "description": "Buyer's selections from customisationGroups for COMPOSED and WITH_EXTRAS resources. One entry per group selected.\n",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "groupId": {
                "type": "string",
                "description": "ID of the customisationGroup selected from",
                "example": "CG-SIZE"
              },
              "optionId": {
                "type": "string",
                "description": "ID of the option selected within the group",
                "example": "OPT-LARGE"
              },
              "priceDelta": {
                "type": "object",
                "additionalProperties": false,
                "description": "Price delta applied by this selection",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "FIXED",
                      "PERCENT"
                    ]
                  },
                  "value": {
                    "type": "number"
                  }
                }
              }
            },
            "required": [
              "groupId",
              "optionId"
            ]
          },
          "x-ion-condition": "Required for COMPOSED and WITH_EXTRAS resources"
        }
      },
      "x-ion-closed-extensions": false
    }
  }
}
