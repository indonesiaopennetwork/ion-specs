{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "ion": "https://schema.ion.id/trade/performance/v1#",
    "rcpa": "https://schema.beckn.io/RetailPerformance#",
    "beckn": "https://schema.beckn.io/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#",

    "Performance": "beckn:Performance",
    "RetailPerformance": "rcpa:RetailPerformance",
    "TradePerformance": "ion:TradePerformance",
    "IONTradePerformance": "ion:IONTradePerformance",
    "fulfillingLocationId": "ion:fulfillingLocationId",

    "agent": "rcpa:agent",

    "performanceMode": "ion:performanceMode",
    "trackingNumber": "ion:trackingNumber",
    "trackingUrl": {
      "@id": "ion:trackingUrl",
      "@type": "@id"
    },
    "estimatedDeliveryTime": {
      "@id": "ion:estimatedDeliveryTime",
      "@type": "xsd:dateTime"
    },
    "logisticsProviderId": "ion:logisticsProviderId",
    "id": "beckn:id",
    "photo": {
      "@id": "ion:photo",
      "@type": "@id"
    },
    "vehicle": "ion:vehicle",
    "type": "ion:type",
    "registrationNumber": "ion:registrationNumber",
    "agentBadgeNumber": "ion:agentBadgeNumber",
    "returnQcDetails": "ion:returnQcDetails",
    "notes": "ion:notes",
    "evidence": "ion:evidence",
    "slaBreaches": "ion:slaBreaches",
    "tatType": "ion:tatType",
    "expectedBy": {
      "@id": "ion:expectedBy",
      "@type": "xsd:dateTime"
    },
    "breachedAt": {
      "@id": "ion:breachedAt",
      "@type": "xsd:dateTime"
    },
    "breachDurationSeconds": "ion:breachDurationSeconds",
    "ageVerification": "ion:ageVerification",
    "method": "ion:method",
    "verifiedAt": {
      "@id": "ion:verifiedAt",
      "@type": "xsd:dateTime"
    },
    "verifiedByAgentId": "ion:verifiedByAgentId",
    "failureReason": "ion:failureReason",
    "packageCount": "ion:packageCount",
    "totalWeight": "ion:totalWeight",
    "deliveryReceiptId": "ion:deliveryReceiptId",

    "stops": "ion:stops",
    "location": "ion:location",
    "geo": "beckn:geo",
    "address": "beckn:address",
    "ionAddressAttributes": "ion:ionAddressAttributes",
    "instructions": "ion:instructions",
    "estimatedArrival": {
      "@id": "ion:estimatedArrival",
      "@type": "xsd:dateTime"
    },
    "actualArrival": {
      "@id": "ion:actualArrival",
      "@type": "xsd:dateTime"
    },
    "proof": {
      "@id": "ion:proof",
      "@type": "@id"
    }
  }
}
