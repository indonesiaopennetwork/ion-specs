{
  "id": "ion-trade-performance-v1",
  "version": "1.0.0",
  "domain": "trade",
  "name": "ION Trade Performance Extension (v1)",
  "description": "Fulfilment execution \u2014 origin location, selected mode, tracking, agent, return QC, SLA breaches, verification, and package facts.",
  "packSchema": "./schema.json",
  "jsonldContext": "./context.jsonld",
  "attachmentPoints": {
    "performanceAttributes": [
      "IONTradePerformance"
    ]
  },
  "extends": "beckn:Performance",
  "stateMachines": "schema/extensions/trade/performance-states/v1/states.yaml",
  "type": "AttributePack",
  "indexing": {
    "indexable": [
      {
        "path": "$.performanceMode"
      },
      {
        "path": "$.fulfillingLocationId"
      }
    ],
    "filterable": [
      {
        "path": "$.performanceMode"
      },
      {
        "path": "$.fulfillingLocationId"
      }
    ],
    "sortable": []
  },
  "minimalForDiscovery": [
    "performanceMode"
  ],
  "x-ion-layer": {
    "generic": "TradePerformance",
    "ion": "IONTradePerformance",
    "splitVersion": "0.7.0"
  }
}
