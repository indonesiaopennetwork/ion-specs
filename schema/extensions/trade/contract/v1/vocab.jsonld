{
  "@context": {
    "ion": "https://schema.ion.id/trade/contract/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "beckn": "https://schema.beckn.io/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:TradeContract",
      "@type": "rdfs:Class",
      "rdfs:label": "TradeContract",
      "rdfs:comment": "TradeContract",
      "rdfs:subClassOf": {
        "@id": "beckn:Contract"
      },
      "skos:broader": {
        "@id": "https://spec.beckn.io/vocab/v2.0.0#Contract"
      }
    },
    {
      "@id": "ion:IONTradeContract",
      "@type": "rdfs:Class",
      "rdfs:label": "IONTradeContract",
      "rdfs:comment": "ION-specific layer for trade contract attributes. Extends the network-agnostic TradeContract layer.",
      "rdfs:subClassOf": {
        "@id": "ion:TradeContract"
      },
      "skos:broader": {
        "@id": "https://spec.beckn.io/vocab/v2.0.0#Contract"
      }
    },
    {
      "@id": "ion:fulfillingLocationId",
      "@type": "rdf:Property",
      "rdfs:label": "fulfillingLocationId",
      "rdfs:comment": "ID of the specific fulfilment centre that will fulfil this order. Populated by BPP at on_confirm after internal FC selection. Present when provider has multiple FC locations.\n"
    },
    {
      "@id": "ion:deliveryPreferences",
      "@type": "rdf:Property",
      "rdfs:label": "deliveryPreferences",
      "rdfs:comment": "Buyer"
    },
    {
      "@id": "ion:invoicePreferences",
      "@type": "rdf:Property",
      "rdfs:label": "invoicePreferences",
      "rdfs:comment": "Buyer's invoice type and tax identity declaration."
    },
    {
      "@id": "ion:fakturPajakReference",
      "@type": "rdf:Property",
      "rdfs:label": "fakturPajakReference",
      "rdfs:comment": "Faktur Pajak (e-Invoice) reference number assigned by BPP after contract confirm for PKP sellers. 16-digit DJP format.\n"
    },
    {
      "@id": "ion:purchaseOrderReference",
      "@type": "rdf:Property",
      "rdfs:label": "purchaseOrderReference",
      "rdfs:comment": "Buyer's Purchase Order number for B2B wholesale transactions. Allows buyer to link ION contract to their internal PO system.\n"
    },
    {
      "@id": "ion:cancellationReasonCode",
      "@type": "rdf:Property",
      "rdfs:label": "cancellationReasonCode",
      "rdfs:comment": "Standardised cancellation reason code when contract is cancelled. Set by BPP on contract at time of cancellation.\n"
    },
    {
      "@id": "ion:quoteTrail",
      "@type": "rdf:Property",
      "rdfs:label": "quoteTrail",
      "rdfs:comment": "Trail of quote changes for price adjustment branch. Each entry records a delta to the original confirmed quote.\n"
    },
    {
      "@id": "ion:partialCancellationAllowed",
      "@type": "rdf:Property",
      "rdfs:label": "partialCancellationAllowed",
      "rdfs:comment": "Whether individual items in a multi-item order can be cancelled."
    },
    {
      "@id": "ion:disputeWindowDays",
      "@type": "rdf:Property",
      "rdfs:label": "disputeWindowDays",
      "rdfs:comment": "Number of days after delivery within which buyer may raise a dispute. Defaults to ION network policy if not declared.\n"
    },
    {
      "@id": "ion:creditTermsDays",
      "@type": "rdf:Property",
      "rdfs:label": "creditTermsDays",
      "rdfs:comment": "Number of days credit extended to the buyer from delivery date. 0 = prepaid. Common values: 7, 14, 30, 45, 60, 90.\n"
    },
    {
      "@id": "ion:paymentDueDate",
      "@type": "rdf:Property",
      "rdfs:label": "paymentDueDate",
      "rdfs:comment": "Absolute datetime by which payment must be made for credit orders. Computed from delivery date + creditTermsDays.\n"
    },
    {
      "@id": "ion:subscriptionBillingCycle",
      "@type": "rdf:Property",
      "rdfs:label": "subscriptionBillingCycle",
      "rdfs:comment": "Billing cycle for subscription commerce pattern."
    },
    {
      "@id": "ion:subscriptionNextBillingDate",
      "@type": "rdf:Property",
      "rdfs:label": "subscriptionNextBillingDate",
      "rdfs:comment": "Date-time of next billing event. Updated by BPP after each successful billing.\n"
    },
    {
      "@id": "ion:linkedContractId",
      "@type": "rdf:Property",
      "rdfs:label": "linkedContractId",
      "rdfs:comment": "Reference to the Trade Contract this Logistics Contract serves. Enables ION Central to trace causal relationship between trade and logistics transactions.\n"
    },
    {
      "@id": "ion:codAmount",
      "@type": "rdf:Property",
      "rdfs:label": "codAmount",
      "rdfs:comment": "Total cash amount to be collected from consumer at delivery for COD orders. String decimal in IDR.\n"
    },
    {
      "@id": "ion:beaCukaiReference",
      "@type": "rdf:Property",
      "rdfs:label": "beaCukaiReference",
      "rdfs:comment": "Indonesian Customs (Bea Cukai) clearance reference number. Required for all international inbound shipments.\n"
    },
    {
      "@id": "ion:liveCommerceContext",
      "@type": "rdf:Property",
      "rdfs:label": "liveCommerceContext",
      "rdfs:comment": "Context for orders placed via live commerce or social commerce (TikTok Shop, Shopee Live, Tokopedia Play, OTT-embedded commerce). Required for B2C-LIVE spine. Enables revenue attribution to streamer/affiliate and platform-specific settlement.\n"
    },
    {
      "@id": "ion:refundDestination",
      "@type": "rdf:Property",
      "rdfs:label": "refundDestination",
      "rdfs:comment": "Where refund will be credited. When buyer does not specify, default is ORIGINAL_PAYMENT_METHOD. Platform wallets often faster; store credit used for partial refunds and goodwill.\n"
    },
    {
      "@id": "ion:subscriptionTrialDays",
      "@type": "rdf:Property",
      "rdfs:label": "subscriptionTrialDays",
      "rdfs:comment": "First N days free. Billing starts on day N+1."
    },
    {
      "@id": "ion:subscriptionPauseType",
      "@type": "rdf:Property",
      "rdfs:label": "subscriptionPauseType",
      "rdfs:comment": "Current pause state for B2C-SUB orders"
    },
    {
      "@id": "ion:subscriptionPauseUntil",
      "@type": "rdf:Property",
      "rdfs:label": "subscriptionPauseUntil",
      "rdfs:comment": "Date to automatically resume. Required when pauseType=PAUSED_UNTIL_DATE"
    },
    {
      "@id": "ion:giftingDetails",
      "@type": "rdf:Property",
      "rdfs:label": "giftingDetails",
      "rdfs:comment": "Structured gifting details replacing the simple gift flag."
    },
    {
      "@id": "ion:paymentSchedule",
      "@type": "rdf:Property",
      "rdfs:label": "paymentSchedule",
      "rdfs:comment": "Multi-milestone payment schedule for partial-payment offers (down-payment + balance, milestone-based for services, etc.). Used when policies.paymentTerms.policyRef references a schedule-based IRI. Single-payment orders do not require this field. Contract moves to COMPLETE only when all milestones are PAID.\n"
    },
    {
      "@id": "ion:accountName",
      "@type": "rdf:Property",
      "rdfs:label": "accountName",
      "rdfs:comment": "Property accountName."
    },
    {
      "@id": "ion:accountNumber",
      "@type": "rdf:Property",
      "rdfs:label": "accountNumber",
      "rdfs:comment": "Property accountNumber."
    },
    {
      "@id": "ion:affiliateId",
      "@type": "rdf:Property",
      "rdfs:label": "affiliateId",
      "rdfs:comment": "Affiliate subscriber ID when sourceChannel=AFFILIATE_LINK"
    },
    {
      "@id": "ion:amount",
      "@type": "rdf:Property",
      "rdfs:label": "amount",
      "rdfs:comment": "IDR amount due at this milestone"
    },
    {
      "@id": "ion:bankAccount",
      "@type": "rdf:Property",
      "rdfs:label": "bankAccount",
      "rdfs:comment": "Required when method=BANK_TRANSFER"
    },
    {
      "@id": "ion:bankCode",
      "@type": "rdf:Property",
      "rdfs:label": "bankCode",
      "rdfs:comment": "Property bankCode."
    },
    {
      "@id": "ion:cancellationReason",
      "@type": "rdf:Property",
      "rdfs:label": "cancellationReason",
      "rdfs:comment": "Structured cancellation reason with machine-readable code and localised description. Set by the requesting party at time of cancel."
    },
    {
      "@id": "ion:cancellationTags",
      "@type": "rdf:Property",
      "rdfs:label": "cancellationTags",
      "rdfs:comment": "Structured metadata bag for the cancellation event. Used in force-cancel (TAT breach) scenarios."
    },
    {
      "@id": "ion:cancelledCommitmentIds",
      "@type": "rdf:Property",
      "rdfs:label": "cancelledCommitmentIds",
      "rdfs:comment": "Line IDs from commitments[] that have been individually cancelled in a partial-cancellation flow."
    },
    {
      "@id": "ion:code",
      "@type": "rdf:Property",
      "rdfs:label": "code",
      "rdfs:comment": "Machine-readable reason code."
    },
    {
      "@id": "ion:currency",
      "@type": "rdf:Property",
      "rdfs:label": "currency",
      "rdfs:comment": "Property currency."
    },
    {
      "@id": "ion:descriptor",
      "@type": "rdf:Property",
      "rdfs:label": "descriptor",
      "rdfs:comment": "Property descriptor."
    },
    {
      "@id": "ion:dueAt",
      "@type": "rdf:Property",
      "rdfs:label": "dueAt",
      "rdfs:comment": "Absolute datetime when payment is due"
    },
    {
      "@id": "ion:dunningReminderSequence",
      "@type": "rdf:Property",
      "rdfs:label": "dunningReminderSequence",
      "rdfs:comment": "Sequence number of this dunning (payment reminder) attempt for overdue credit orders."
    },
    {
      "@id": "ion:end",
      "@type": "rdf:Property",
      "rdfs:label": "end",
      "rdfs:comment": "Property end."
    },
    {
      "@id": "ion:expectedStatusBy",
      "@type": "rdf:Property",
      "rdfs:label": "expectedStatusBy",
      "rdfs:comment": "Datetime by which BPP was expected to send on_status per declared SLA."
    },
    {
      "@id": "ion:force",
      "@type": "rdf:Property",
      "rdfs:label": "force",
      "rdfs:comment": "True when BAP is force-cancelling due to BPP TAT breach."
    },
    {
      "@id": "ion:gatewayRef",
      "@type": "rdf:Property",
      "rdfs:label": "gatewayRef",
      "rdfs:comment": "Gateway transaction reference for this milestone"
    },
    {
      "@id": "ion:gift",
      "@type": "rdf:Property",
      "rdfs:label": "gift",
      "rdfs:comment": "Simple gift flag. When true, populate giftingDetails for recipient name, message, and wrap preferences."
    },
    {
      "@id": "ion:giftMessage",
      "@type": "rdf:Property",
      "rdfs:label": "giftMessage",
      "rdfs:comment": "Message printed on gift card / packing slip"
    },
    {
      "@id": "ion:giftWrapOfferId",
      "@type": "rdf:Property",
      "rdfs:label": "giftWrapOfferId",
      "rdfs:comment": "Reference to the gift-wrap offer in consideration breakup"
    },
    {
      "@id": "ion:graceDays",
      "@type": "rdf:Property",
      "rdfs:label": "graceDays",
      "rdfs:comment": "Grace period before status becomes OVERDUE"
    },
    {
      "@id": "ion:groupBuyActivated",
      "@type": "rdf:Property",
      "rdfs:label": "groupBuyActivated",
      "rdfs:comment": "Whether group-buy discount has been unlocked"
    },
    {
      "@id": "ion:groupBuyId",
      "@type": "rdf:Property",
      "rdfs:label": "groupBuyId",
      "rdfs:comment": "Group-buy session ID when sourceChannel=GROUP_BUY"
    },
    {
      "@id": "ion:groupBuyMinParticipants",
      "@type": "rdf:Property",
      "rdfs:label": "groupBuyMinParticipants",
      "rdfs:comment": "Minimum participants needed for group discount to activate"
    },
    {
      "@id": "ion:hideSenderInfo",
      "@type": "rdf:Property",
      "rdfs:label": "hideSenderInfo",
      "rdfs:comment": "Anonymous gift — omit buyer details from all visible surfaces"
    },
    {
      "@id": "ion:id",
      "@type": "rdf:Property",
      "rdfs:label": "id",
      "rdfs:comment": "Item ID or consideration ID this adjustment applies to"
    },
    {
      "@id": "ion:invoiceType",
      "@type": "rdf:Property",
      "rdfs:label": "invoiceType",
      "rdfs:comment": "RECEIPT: simple receipt, no tax identity required. TAX_INVOICE: Faktur Pajak, requires PKP seller and NPWP buyer. EINVOICE: e-Faktur via DJP system. SURAT_TAGIHAN: PKP seller to non-PKP buyer — commercial invoice, no input-tax claim rights. KOMERSIAL_INVOICE: cross-border commercial invoice, bilingual layout."
    },
    {
      "@id": "ion:isGift",
      "@type": "rdf:Property",
      "rdfs:label": "isGift",
      "rdfs:comment": "Property isGift."
    },
    {
      "@id": "ion:lastBppInteractionAt",
      "@type": "rdf:Property",
      "rdfs:label": "lastBppInteractionAt",
      "rdfs:comment": "Timestamp of last received BPP message — documents the TAT breach."
    },
    {
      "@id": "ion:legalEntityName",
      "@type": "rdf:Property",
      "rdfs:label": "legalEntityName",
      "rdfs:comment": "Registered legal entity name of the buyer organisation for B2B wholesale and business-procurement patterns."
    },
    {
      "@id": "ion:liveSessionId",
      "@type": "rdf:Property",
      "rdfs:label": "liveSessionId",
      "rdfs:comment": "Live session identifier when sourceChannel=LIVE_STREAM"
    },
    {
      "@id": "ion:loyaltyMultiplier",
      "@type": "rdf:Property",
      "rdfs:label": "loyaltyMultiplier",
      "rdfs:comment": "Bonus multiplier when redeeming to loyalty points e.g. 1.1 = 10% bonus"
    },
    {
      "@id": "ion:method",
      "@type": "rdf:Property",
      "rdfs:label": "method",
      "rdfs:comment": "Property method."
    },
    {
      "@id": "ion:milestone",
      "@type": "rdf:Property",
      "rdfs:label": "milestone",
      "rdfs:comment": "Event that triggers this payment"
    },
    {
      "@id": "ion:milestoneLabel",
      "@type": "rdf:Property",
      "rdfs:label": "milestoneLabel",
      "rdfs:comment": "Human-readable milestone label (e.g. \"30% down-payment\")"
    },
    {
      "@id": "ion:nib",
      "@type": "rdf:Property",
      "rdfs:label": "nib",
      "rdfs:comment": "Nomor Induk Berusaha (Business Registration Number) of the buyer organisation."
    },
    {
      "@id": "ion:npwp",
      "@type": "rdf:Property",
      "rdfs:label": "npwp",
      "rdfs:comment": "NPWP (Nomor Pokok Wajib Pajak) of the buyer. Required when invoicePreferences.invoiceType=TAX_INVOICE."
    },
    {
      "@id": "ion:ottContentId",
      "@type": "rdf:Property",
      "rdfs:label": "ottContentId",
      "rdfs:comment": "OTT platform's content ID (movie, episode, match) where item was shown"
    },
    {
      "@id": "ion:ottPlatform",
      "@type": "rdf:Property",
      "rdfs:label": "ottPlatform",
      "rdfs:comment": "OTT platform where shoppable content was served (for OTT_EMBEDDED)"
    },
    {
      "@id": "ion:ottTimestampSeconds",
      "@type": "rdf:Property",
      "rdfs:label": "ottTimestampSeconds",
      "rdfs:comment": "Playback position in seconds when product was presented"
    },
    {
      "@id": "ion:paidAt",
      "@type": "rdf:Property",
      "rdfs:label": "paidAt",
      "rdfs:comment": "Property paidAt."
    },
    {
      "@id": "ion:paymentMethod",
      "@type": "rdf:Property",
      "rdfs:label": "paymentMethod",
      "rdfs:comment": "Method used for this specific milestone (may differ across milestones)"
    },
    {
      "@id": "ion:preferredPerformanceMode",
      "@type": "rdf:Property",
      "rdfs:label": "preferredPerformanceMode",
      "rdfs:comment": "Property preferredPerformanceMode."
    },
    {
      "@id": "ion:preferredTimeSlot",
      "@type": "rdf:Property",
      "rdfs:label": "preferredTimeSlot",
      "rdfs:comment": "Buyer's preferred delivery time window."
    },
    {
      "@id": "ion:priceDisplayOnPackage",
      "@type": "rdf:Property",
      "rdfs:label": "priceDisplayOnPackage",
      "rdfs:comment": "Whether to show prices on packing slip"
    },
    {
      "@id": "ion:productPinnedAtMinute",
      "@type": "rdf:Property",
      "rdfs:label": "productPinnedAtMinute",
      "rdfs:comment": "Minutes into the live session when this product was pinned/featured"
    },
    {
      "@id": "ion:reason",
      "@type": "rdf:Property",
      "rdfs:label": "reason",
      "rdfs:comment": "Human-readable reason for this adjustment"
    },
    {
      "@id": "ion:recipientName",
      "@type": "rdf:Property",
      "rdfs:label": "recipientName",
      "rdfs:comment": "Property recipientName."
    },
    {
      "@id": "ion:recipientPhone",
      "@type": "rdf:Property",
      "rdfs:label": "recipientPhone",
      "rdfs:comment": "Property recipientPhone."
    },
    {
      "@id": "ion:scheme",
      "@type": "rdf:Property",
      "rdfs:label": "scheme",
      "rdfs:comment": "NPWP for businesses, NIK for individuals"
    },
    {
      "@id": "ion:shortDesc",
      "@type": "rdf:Property",
      "rdfs:label": "shortDesc",
      "rdfs:comment": "Localised short reason for consumer display."
    },
    {
      "@id": "ion:shortVideoId",
      "@type": "rdf:Property",
      "rdfs:label": "shortVideoId",
      "rdfs:comment": "Short-video/reel ID when sourceChannel=SHORT_VIDEO"
    },
    {
      "@id": "ion:sourceChannel",
      "@type": "rdf:Property",
      "rdfs:label": "sourceChannel",
      "rdfs:comment": "Entry point for the order. OTT_EMBEDDED = order placed from within video streaming app (Netflix, Vidio, Disney+ Hotstar shoppable content)."
    },
    {
      "@id": "ion:start",
      "@type": "rdf:Property",
      "rdfs:label": "start",
      "rdfs:comment": "Property start."
    },
    {
      "@id": "ion:status",
      "@type": "rdf:Property",
      "rdfs:label": "status",
      "rdfs:comment": "Property status."
    },
    {
      "@id": "ion:streamerCommissionPercent",
      "@type": "rdf:Property",
      "rdfs:label": "streamerCommissionPercent",
      "rdfs:comment": "Streamer's commission as fraction of item value"
    },
    {
      "@id": "ion:streamerId",
      "@type": "rdf:Property",
      "rdfs:label": "streamerId",
      "rdfs:comment": "Creator/streamer subscriber ID for revenue attribution. Streamer may earn commission separately from BPP/BAP."
    },
    {
      "@id": "ion:subscriptionAction",
      "@type": "rdf:Property",
      "rdfs:label": "subscriptionAction",
      "rdfs:comment": "Action being applied to a subscription in a lifecycle management /update call."
    },
    {
      "@id": "ion:taxId",
      "@type": "rdf:Property",
      "rdfs:label": "taxId",
      "rdfs:comment": "Property taxId."
    },
    {
      "@id": "ion:type",
      "@type": "rdf:Property",
      "rdfs:label": "type",
      "rdfs:comment": "Property type."
    },
    {
      "@id": "ion:value",
      "@type": "rdf:Property",
      "rdfs:label": "value",
      "rdfs:comment": "Tax ID number"
    },
    {
      "@id": "ion:walletId",
      "@type": "rdf:Property",
      "rdfs:label": "walletId",
      "rdfs:comment": "Required when method=PLATFORM_WALLET"
    }
  ]
}
