{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "ion": "https://schema.ion.id/trade/contract/v1#",
    "ionid": "https://schema.ion.id/core/identity/v1#",
    "rcca": "https://schema.beckn.io/RetailContract#",
    "beckn": "https://schema.beckn.io/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "Contract": "beckn:Contract",
    "RetailContract": "rcca:RetailContract",
    "TradeContract": "ion:TradeContract",
    "IONTradeContract": "ion:IONTradeContract",
    "quoteReference": "rcca:quoteReference",
    "buyerInstructions": "rcca:buyerInstructions",
    "deliveryPreferences": {
      "@id": "rcca:deliveryPreferences",
      "@context": {
        "leaveAtDoor": "rcca:leaveAtDoor",
        "contactless": "rcca:contactless",
        "preferredTimeSlot": {
          "@id": "rcca:preferredTimeSlot",
          "@context": {
            "start": "rcca:timeSlotStart",
            "end": "rcca:timeSlotEnd"
          }
        }
      }
    },
    "loyalty": {
      "@id": "rcca:loyalty",
      "@context": {
        "programId": "rcca:loyaltyProgramId",
        "pointsRedeemed": "rcca:pointsRedeemed"
      }
    },
    "purchaseOrderReference": "ion:purchaseOrderReference",
    "parentContractId": "ion:parentContractId",
    "reason": "ion:reason",
    "commitmentIds": "ion:commitmentIds",
    "forced": "ion:forced",
    "lastProviderInteractionAt": "ion:lastProviderInteractionAt",
    "expectedStatusBy": "ion:expectedStatusBy",
    "billingCycle": "ion:billingCycle",
    "trialDays": "ion:trialDays",
    "status": "ion:status",
    "pausedUntil": "ion:pausedUntil",
    "nextBillingAt": "ion:nextBillingAt",
    "sessionId": "ion:sessionId",
    "creatorId": "ion:creatorId",
    "affiliateId": "ion:affiliateId",
    "platform": "ion:platform",
    "contentId": "ion:contentId",
    "contentTimestampSeconds": "ion:contentTimestampSeconds",
    "groupBuyId": "ion:groupBuyId",
    "recipientName": "ion:recipientName",
    "recipientPhone": "ion:recipientPhone",
    "hideSenderInfo": "ion:hideSenderInfo",
    "showPrice": "ion:showPrice",
    "invoiceType": "ion:invoiceType",
    "cancellation": "ion:cancellation",
    "subscription": "ion:subscription",
    "source": {
      "@id": "rcca:source",
      "@context": {
        "channel": "rcca:sourceChannel",
        "campaignId": "rcca:campaignId"
      }
    },
    "gift": {
      "@id": "rcca:gift",
      "@context": {
        "isGift": "rcca:isGift",
        "message": "rcca:giftMessage",
        "wrap": "rcca:giftWrap"
      }
    },
    "invoicePreferences": {
      "@id": "rcca:invoicePreferences",
      "@context": {
        "taxId": {
          "@id": "rcca:taxId",
          "@context": {
            "scheme": "rcca:taxIdScheme",
            "country": "rcca:taxIdCountry",
            "value": "rcca:taxIdValue"
          }
        },
        "companyName": "rcca:invoiceCompanyName",
        "email": "rcca:invoiceEmail"
      }
    },
    "buyerBusinessRegistration": {
      "@id": "ion:buyerBusinessRegistration",
      "@context": {
        "npwp": "ionid:npwp",
        "nib": "ionid:nib",
        "nikNumber": "ionid:nikNumber",
        "pkpStatus": "ionid:pkpStatus",
        "legalEntityName": "ionid:legalEntityName",
        "businessType": "ionid:businessType",
        "siupNumber": "ionid:siupNumber",
        "spPIRTNumber": "ionid:spPIRTNumber"
      }
    }
  }
}
