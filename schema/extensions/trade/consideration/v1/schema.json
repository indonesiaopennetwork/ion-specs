{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/trade/consideration/v1",
  "title": "ION Trade Consideration Schema Pack v1",
  "description": "JSON Schema 2020-12 mirror of the trade/consideration/v1 OpenAPI schema pack. The root resolves to IONTradeConsideration, which inherits directly from RetailConsideration v2.1.",
  "type": "object",
  "$ref": "#/$defs/IONTradeConsideration",
  "$defs": {
    "IONTradeConsideration": {
      "type": "object",
      "title": "IONTradeConsideration",
      "description": "ION trade consideration attributes. Inherits directly from RetailConsideration v2.1 and refines inherited breakup taxDetail objects with the shared IONTaxDetail schema.",
      "x-ion-layer": "ion",
      "x-ion-split-version": "0.7.0",
      "x-recommended-parent": "Consideration.considerationAttributes",
      "additionalProperties": true,
      "x-jsonld": {
        "@context": "https://schema.ion.id/trade/consideration/v1/context.jsonld",
        "@type": "ion:IONTradeConsideration"
      },
      "x-beckn-attaches-to": "Consideration.considerationAttributes",
      "x-ion-closed-extensions": false,
      "allOf": [
        {
          "$ref": "https://schema.beckn.io/RetailConsideration/v2.1/attributes.yaml#/components/schemas/RetailConsideration"
        }
      ],
      "properties": {
        "breakup": {
          "x-attr-ion-layer": "ion",
          "type": "array",
          "description": "Inherited RetailConsideration price breakup, refined so each taxDetail object may carry IONTaxDetail classification and compliance fields.\n",
          "items": {
            "allOf": [
              {
                "$ref": "https://schema.beckn.io/RetailConsideration/v2.1/attributes.yaml#/components/schemas/RetailConsideration/properties/breakup/items"
              },
              {
                "type": "object",
                "properties": {
                  "taxDetail": {
                    "allOf": [
                      {
                        "$ref": "https://schema.ion.id/extensions/core/tax/v1/schema.json"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
