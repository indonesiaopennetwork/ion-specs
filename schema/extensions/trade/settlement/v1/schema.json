{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/trade/settlement/v1",
  "title": "ION Trade Settlement Schema Pack v1",
  "description": "JSON Schema 2020-12 mirror of the trade/settlement/v1 OpenAPI schema pack. The root resolves to IONTradeSettlement; TradeSettlement inherits RetailSettlement v2.1.",
  "type": "object",
  "$ref": "#/$defs/IONTradeSettlement",
  "$defs": {
    "TradeSettlement": {
      "type": "object",
      "title": "TradeSettlement",
      "description": "Network-agnostic trade settlement layer. Inherits RetailSettlement v2.1 and exposes its fields through property-level references so the local JSON Schema and JSON-LD artifacts remain aligned.",
      "x-ion-layer": "generic",
      "x-ion-split-version": "0.7.0",
      "x-recommended-parent": "Settlement.settlementAttributes",
      "additionalProperties": true,
      "allOf": [
        {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement"
        }
      ],
      "properties": {
        "gateway": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/gateway"
        },
        "method": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/method"
        },
        "paymentRail": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/paymentRail"
        },
        "settledAt": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/settledAt"
        },
        "settledAmount": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/settledAmount"
        },
        "currency": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/currency"
        },
        "refund": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/refund"
        },
        "adjustments": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/adjustments"
        },
        "reconciliationId": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/reconciliationId"
        },
        "reconciliationStatus": {
          "$ref": "https://schema.beckn.io/RetailSettlement/v2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/reconciliationStatus"
        }
      }
    },
    "IONTradeSettlement": {
      "type": "object",
      "title": "IONTradeSettlement",
      "description": "ION-specific extension point for TradeSettlement. Domestic currency constraints belong to ION network policy so cross-border settlement remains expressible.",
      "x-ion-layer": "ion",
      "x-ion-split-version": "0.7.0",
      "allOf": [
        {
          "$ref": "#/$defs/TradeSettlement"
        }
      ],
      "additionalProperties": true,
      "x-jsonld": {
        "@context": "https://schema.ion.id/trade/settlement/v1/context.jsonld",
        "@type": "ion:IONTradeSettlement"
      },
      "x-beckn-attaches-to": "Settlement.settlementAttributes",
      "properties": {},
      "x-ion-closed-extensions": false
    }
  }
}
