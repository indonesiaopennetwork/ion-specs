{
  "id": "ion-trade-settlement-v1",
  "version": "1.0.0",
  "domain": "trade",
  "name": "ION Trade Settlement Extension (v1)",
  "description": "Payment method declaration, collection party, timing, status, and payment instrument detail. Also carries refund declarations for cancellation and return flows.",
  "packSchema": "./schema.json",
  "jsonldContext": "./context.jsonld",
  "attachmentPoints": {
    "settlementAttributes": [
      "IONTradeSettlement"
    ]
  },
  "extends": "beckn:Settlement",
  "type": "AttributePack",
  "indexing": {
    "indexable": [
      { "path": "$.method" },
      { "path": "$.paymentRail" },
      { "path": "$.status" }
    ],
    "filterable": [
      { "path": "$.method" },
      { "path": "$.collectedBy" },
      { "path": "$.status" }
    ],
    "sortable": []
  },
  "minimalForDiscovery": [
    "method",
    "paymentRail",
    "collectedBy"
  ],
  "x-ion-layer": {
    "generic": "TradeSettlement",
    "ion": "IONTradeSettlement",
    "splitVersion": "0.7.0"
  }
}
