{
  "@context": "https://schema.ion.id/trade/offer/v1/context.jsonld",
  "@type": "ion:IONTradeOffer",
  "_comment": "Example: F&B offer (food-qsr/delivery) — returns not allowed, free cancellation before preparation",
  "timeToShip": "PT30M",
  "selfPickupOtp": true,
  "selfPickupInstructions": "Tunjukkan kode pickup di kasir",
  "proofOfDeliveryType": "PHOTO",
  "contactDetailsConsumerCare": {
    "name": "Customer Service Domino's",
    "email": "cs@dominos.co.id",
    "phone": "021-500300"
  },
  "displayLanguage": [
    "id",
    "en"
  ],
  "policies": {
    "returns": {
      "allowed": false,
      "policyRef": "ion://policy/return.standard.none"
    },
    "cancellation": {
      "allowedReasons": [
        "CHANGE_OF_MIND",
        "WRONG_ITEM_ORDERED"
      ],
      "policyRef": "ion://policy/cancel.mto.nofee-before-prepare"
    },
    "warranty": {
      "policyRef": "ion://policy/warranty.standard.none"
    },
    "dispute": {
      "policyRef": "ion://policy/dispute.consumer.bpsk"
    },
    "grievanceSla": {
      "policyRef": "ion://policy/grievance-sla.consumer.standard"
    },
    "paymentTerms": {
      "policyRef": "ion://policy/payment-terms.upfront.full"
    }
  },
  "paymentConstraints": {
    "codAvailable": true
  }
}
