{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ION Release Manifest",
  "description": "Manifest for a permanent ION integer release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "name",
    "status",
    "publishedAt",
    "publicBaseUrl",
    "sourceBranch",
    "contentStatus",
    "dependencyStatus",
    "dependencies",
    "maintainedArtifacts",
    "implementationGuidance",
    "artifactChecksums"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "release": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "pattern": "^release[1-9][0-9]*$"
    },
    "status": {
      "enum": ["draft", "published"]
    },
    "publishedAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "publicBaseUrl": {
      "type": "string",
      "pattern": "^https://schema\\.ion\\.id/release[1-9][0-9]*/$"
    },
    "sourceBranch": {
      "const": "main"
    },
    "contentStatus": {
      "type": "object"
    },
    "dependencyStatus": {
      "enum": ["incomplete", "complete"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "maintainedArtifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/maintainedArtifact"
      }
    },
    "implementationGuidance": {
      "$ref": "#/$defs/implementationGuidance"
    },
    "artifactChecksums": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/releaseRelativePath"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "toolingCommit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": 1 }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "contentStatus": { "$ref": "#/$defs/contentStatusV1" },
          "implementationGuidance": {
            "properties": {
              "areas": {
                "propertyNames": {
                  "enum": ["ionApi", "common", "trade", "logistics", "hospitality", "finance", "flows", "errors"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": 2 }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "contentStatus": { "$ref": "#/$defs/contentStatusV2" },
          "implementationGuidance": {
            "properties": {
              "areas": {
                "propertyNames": {
                  "enum": ["ionApi", "common", "trade", "logistics", "hospitality", "finance", "flows", "errors", "rules"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "draft" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "publishedAt": { "type": "null" },
          "artifactChecksums": {
            "propertyNames": {
              "allOf": [
                { "$ref": "#/$defs/releaseRelativePath" },
                { "pattern": "^schema/vendored/" }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "published" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "publishedAt": { "type": "string", "format": "date-time" },
          "dependencyStatus": { "const": "complete" },
          "contentStatus": { "$ref": "#/$defs/publishedContentStatus" },
          "dependencies": { "minItems": 1 },
          "artifactChecksums": { "minProperties": 1 },
          "toolingCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        },
        "required": ["toolingCommit"]
      }
    }
  ],
  "$defs": {
    "contentState": {
      "enum": ["review-required", "validation-pending", "validated", "excluded"]
    },
    "contentStatusV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ionApi", "common", "trade", "logistics", "hospitality", "finance", "flows", "errors"],
      "properties": {
        "ionApi": { "$ref": "#/$defs/contentState" },
        "common": { "$ref": "#/$defs/contentState" },
        "trade": { "$ref": "#/$defs/contentState" },
        "logistics": { "$ref": "#/$defs/contentState" },
        "hospitality": { "$ref": "#/$defs/contentState" },
        "finance": { "$ref": "#/$defs/contentState" },
        "flows": { "$ref": "#/$defs/contentState" },
        "errors": { "$ref": "#/$defs/contentState" }
      }
    },
    "contentStatusV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ionApi", "common", "trade", "logistics", "hospitality", "finance", "flows", "errors", "rules"],
      "properties": {
        "ionApi": { "$ref": "#/$defs/contentState" },
        "common": { "$ref": "#/$defs/contentState" },
        "trade": { "$ref": "#/$defs/contentState" },
        "logistics": { "$ref": "#/$defs/contentState" },
        "hospitality": { "$ref": "#/$defs/contentState" },
        "finance": { "$ref": "#/$defs/contentState" },
        "flows": { "$ref": "#/$defs/contentState" },
        "errors": { "$ref": "#/$defs/contentState" },
        "rules": { "$ref": "#/$defs/contentState" }
      }
    },
    "publishedContentStatus": {
      "type": "object",
      "additionalProperties": { "enum": ["validated", "excluded"] }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "upstreamVersion",
        "upstreamRepository",
        "upstreamCommit",
        "upstreamUrl",
        "vendoredPath",
        "upstreamSha256",
        "releasedSha256",
        "license",
        "transformations"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["protocol", "schema"] },
        "upstreamVersion": { "type": "string", "minLength": 1 },
        "upstreamRepository": { "type": "string", "format": "uri" },
        "upstreamCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "upstreamUrl": { "type": "string", "format": "uri" },
        "vendoredPath": {
          "allOf": [
            { "$ref": "#/$defs/releaseRelativePath" },
            { "pattern": "^schema/vendored/" }
          ]
        },
        "upstreamSha256": { "$ref": "#/$defs/sha256" },
        "releasedSha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "minLength": 1 },
        "transformations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "maintainedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "path",
        "upstreamVersion",
        "upstreamRepository",
        "upstreamCommit",
        "upstreamUrl",
        "upstreamSha256",
        "releasedSha256",
        "license",
        "transformations"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "const": "protocol" },
        "path": {
          "allOf": [
            { "$ref": "#/$defs/releaseRelativePath" },
            { "pattern": "^schema/core/" }
          ]
        },
        "upstreamVersion": { "type": "string", "minLength": 1 },
        "upstreamRepository": { "type": "string", "format": "uri" },
        "upstreamCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "upstreamUrl": { "type": "string", "format": "uri" },
        "upstreamSha256": { "$ref": "#/$defs/sha256" },
        "releasedSha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "minLength": 1 },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "implementationGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryProfile", "areas"],
      "properties": {
        "primaryProfile": { "$ref": "#/$defs/primaryImplementationProfile" },
        "areas": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": ["ionApi", "common", "trade", "logistics", "hospitality", "finance", "flows", "errors", "rules"]
          },
          "additionalProperties": { "$ref": "#/$defs/implementationAreaGuidance" }
        }
      }
    },
    "primaryImplementationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "maturity", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": {
          "allOf": [
            { "$ref": "#/$defs/releaseRelativePath" },
            { "pattern": "^flows/" }
          ]
        },
        "maturity": { "$ref": "#/$defs/implementationMaturity" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "implementationAreaGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maturity", "notes"],
      "properties": {
        "maturity": { "$ref": "#/$defs/implementationMaturity" },
        "primaryProfile": { "type": "string", "minLength": 1 },
        "productionRecommended": { "type": "boolean" },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "implementationMaturity": {
      "enum": ["implementation-ready", "reference", "preview", "excluded"]
    },
    "releaseRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
