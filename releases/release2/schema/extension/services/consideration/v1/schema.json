{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/release2/schema/extension/services/consideration/v1",
  "$ref": "#/$defs/IONSocialSchemeConsiderationAttributes",
  "$defs": {
    "SocialSchemeConsideration": {
      "type": "object",
      "title": "SocialSchemeConsideration",
      "description": "Network-agnostic generic layer. Inherits from Beckn core Attributes.",
      "x-ion-layer": "generic",
      "x-ion-split-version": "1.0.0",
      "x-recommended-parent": "Consideration.considerationAttributes",
      "additionalProperties": true,
      "allOf": [
        {
          "$ref": "https://schema.ion.id/release2/schema/vendored/beckn/schemas/Attributes/2.0/attributes.yaml#/components/schemas/Attributes"
        }
      ]
    },
    "IONSocialSchemeConsiderationAttributes": {
      "type": "object",
      "x-ion-layer": "ion",
      "x-ion-split-version": "1.0.0",
      "allOf": [
        {
          "$ref": "#/$defs/SocialSchemeConsideration"
        }
      ],
      "description": "A single price-breakup line for a social-scheme facilitation service.\n",
      "x-jsonld": {
        "@context": "https://schema.ion.id/release2/schema/extension/services/consideration/v1/context.jsonld",
        "@type": "ion:IONSocialSchemeConsiderationAttributes"
      },
      "x-beckn-attaches-to": "Consideration.considerationAttributes",
      "additionalProperties": true,
      "properties": {
        "breakupLineType": {
          "type": "string",
          "description": "What this price line represents.",
          "enum": [
            "FACILITATION_FEE",
            "DOCUMENT_PROCESSING_FEE",
            "GOVERNMENT_FEE_PASSTHROUGH",
            "DISCOUNT",
            "TAX"
          ],
          "example": "FACILITATION_FEE"
        },
        "totalAmount": {
          "type": "number",
          "minimum": 0,
          "example": 25000
        },
        "currency": {
          "type": "string",
          "default": "IDR",
          "example": "IDR"
        },
        "governmentFeeReceipt": {
          "type": "string",
          "description": "When breakupLineType is GOVERNMENT_FEE_PASSTHROUGH (e.g. a statutory document-issuance fee the scheme itself charges), reference number for the official government receipt this line passes through. Absent for facilitation-only lines.\n",
          "example": "PNBP-2026-00019284"
        }
      }
    }
  }
}
