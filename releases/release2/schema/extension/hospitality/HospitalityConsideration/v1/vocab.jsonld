  "@graph": [
    {
      "@id": "ion:IONHospitalityConsideration",
      "@type": "rdfs:Class",
      "rdfs:label": "IONHospitalityConsideration",
      "rdfs:comment": "Draft hospitality consideration extension for event admission ticketing."
    },
    {
      "@id": "ion:currency",
      "@type": "rdf:Property",
      "rdfs:label": "currency",
      "rdfs:comment": "ISO 4217 currency code."
    },
    {
      "@id": "ion:components",
      "@type": "rdf:Property",
      "rdfs:label": "components",
      "rdfs:comment": "Price components expressed in minor units for the declared currency; inclusive components are informational."
    },
    {
      "@id": "ion:componentId",
      "@type": "rdf:Property",
      "rdfs:label": "componentId",
      "rdfs:comment": "Component identity."
    },
    {
      "@id": "ion:lineRef",
      "@type": "rdf:Property",
      "rdfs:label": "lineRef",
      "rdfs:comment": "Affected commitment or entitlement."
    },
    {
      "@id": "ion:kind",
      "@type": "rdf:Property",
      "rdfs:label": "kind",
      "rdfs:comment": "Component role."
    },
    {
      "@id": "ion:amountMinor",
      "@type": "rdf:Property",
      "rdfs:label": "amountMinor",
      "rdfs:comment": "Nonnegative magnitude in currency minor units."
    },
    {
      "@id": "ion:included",
      "@type": "rdf:Property",
      "rdfs:label": "included",
      "rdfs:comment": "Already included in base price."
    },
    {
      "@id": "ion:funderRef",
      "@type": "rdf:Property",
      "rdfs:label": "funderRef",
      "rdfs:comment": "Party funding discount."
    },
    {
      "@id": "ion:payableMinor",
      "@type": "rdf:Property",
      "rdfs:label": "payableMinor",
      "rdfs:comment": "Agreed amount payable in minor units."
    },
    {
      "@id": "ion:paymentState",
      "@type": "rdf:Property",
      "rdfs:label": "paymentState",
      "rdfs:comment": "Authoritative payment outcome."
    },
    {
      "@id": "ion:paymentRef",
      "@type": "rdf:Property",
      "rdfs:label": "paymentRef",
      "rdfs:comment": "Opaque common payment evidence reference."
    },
    {
      "@id": "ion:refunds",
      "@type": "rdf:Property",
      "rdfs:label": "refunds",
      "rdfs:comment": "Refund obligations independent of ticket state."
    },
    {
      "@id": "ion:refundId",
      "@type": "rdf:Property",
      "rdfs:label": "refundId",
      "rdfs:comment": "Stable refund operation ID."
    },
    {
