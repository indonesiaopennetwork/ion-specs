    },
    {
      "@id": "ion:scope",
      "@type": "rdf:Property",
      "rdfs:label": "scope",
      "rdfs:comment": "scope"
    },
    {
      "@id": "ion:attemptRef",
      "@type": "rdf:Property",
      "rdfs:label": "attemptRef",
      "rdfs:comment": "Stable failed booking attempt."
    },
    {
