      "rdfs:label": "IONHospitalityResource",
      "rdfs:comment": "Draft hospitality resource extension for event admission ticketing."
    },
    {
      "@id": "ion:crc",
      "@type": "rdf:Property",
      "rdfs:label": "crc",
      "rdfs:comment": "Catalogue resource category. This draft is scoped to events."
    },
    {
      "@id": "ion:event",
      "@type": "rdf:Property",
      "rdfs:label": "event",
      "rdfs:comment": "Event identity and schedule shared by admission offers."
    },
