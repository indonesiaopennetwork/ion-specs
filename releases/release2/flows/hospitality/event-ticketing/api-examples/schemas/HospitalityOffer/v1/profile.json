      {
        "path": "$.allocationMode"
      },
      {
        "path": "$.salesStart"
      },
      {
        "path": "$.salesEnd"
      }
    ],
    "filterable": [
      {
        "path": "$.eventRef"
      },
      {
        "path": "$.admissionClass"
      },
      {
        "path": "$.allocationMode"
      },
      {
        "path": "$.salesStart"
      },
      {
        "path": "$.salesEnd"
      }
    ],
    "sortable": []
  },
  "minimalForDiscovery": [
    "eventRef",
    "admissionClass",
    "allocationMode",
    "rights",
    "salesStart",
    "salesEnd"
  ]
}
