{
  "id": "ion-hospitality-offer-v1",
  "version": "1.0.0",
  "domain": "hospitality",
  "type": "AttributePack",
  "name": "ION Hospitality Offer Extension (v1)",
  "packSchema": "./schema.json",
  "jsonldContext": "./context.jsonld",
  "extends": "beckn:Offer",
