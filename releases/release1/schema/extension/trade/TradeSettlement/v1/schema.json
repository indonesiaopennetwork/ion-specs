{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/release1/schema/extension/trade/TradeSettlement/v1",
  "title": "ION Trade Settlement Schema Pack v1",
  "description": "JSON Schema 2020-12 mirror of the trade/settlement/v1 OpenAPI schema pack. The root resolves to IONTradeSettlement, which inherits RetailSettlement v2.1 directly.",
  "type": "object",
  "$ref": "#/$defs/IONTradeSettlement",
  "$defs": {
    "IONTradeSettlement": {
      "type": "object",
      "title": "IONTradeSettlement",
      "description": "ION trade settlement attributes. Inherits RetailSettlement v2.1, exposes its fields through property-level references, and adds the ION settlement due-date terms settlementBasis and settlementWindow. Properties originating in the ION-specific layer are identified by x-attr-ion-layer: ion.",
      "x-ion-layer": "ion",
      "x-ion-split-version": "0.7.0",
      "x-recommended-parent": "Settlement.settlementAttributes",
      "additionalProperties": true,
      "x-jsonld": {
        "@context": "https://schema.ion.id/release1/schema/extension/trade/TradeSettlement/v1/context.jsonld",
        "@type": "ion:IONTradeSettlement"
      },
      "x-beckn-attaches-to": "Settlement.settlementAttributes",
      "x-ion-closed-extensions": false,
      "allOf": [
        {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement"
        }
      ],
      "properties": {
        "gateway": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/gateway"
        },
        "method": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/method"
        },
        "paymentRail": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/paymentRail"
        },
        "settledAt": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/settledAt"
        },
        "settledAmount": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/settledAmount"
        },
        "currency": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/currency"
        },
        "refund": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/refund"
        },
        "adjustments": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/adjustments"
        },
        "reconciliationId": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/reconciliationId"
        },
        "reconciliationStatus": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/RetailSettlement/2.1/attributes.yaml#/components/schemas/RetailSettlement/properties/reconciliationStatus"
        },
        "settlementBasis": {
          "type": "string",
          "x-attr-ion-layer": "ion",
          "enum": [
            "ON_CONFIRMATION",
            "AFTER_SHIPMENT",
            "AFTER_DELIVERY",
            "AFTER_RETURN_WINDOW"
          ],
          "description": "Contract lifecycle event from which the settlement falls due. ON_CONFIRMATION starts at order confirmation, AFTER_SHIPMENT at hand-over to logistics, AFTER_DELIVERY at confirmed delivery, and AFTER_RETURN_WINDOW when the applicable return window closes.",
          "example": "AFTER_DELIVERY"
        },
        "settlementWindow": {
          "type": "string",
          "format": "duration",
          "x-attr-ion-layer": "ion",
          "description": "ISO 8601 duration, measured from the settlementBasis event, within which the collector must settle with the receiver.",
          "example": "P1D"
        }
      }
    }
  }
}
