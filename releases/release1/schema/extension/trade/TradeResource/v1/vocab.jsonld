      "rdfs:comment": "Property unitQuantity."
    },
    {
      "@id": "schema:unitText",
      "@type": "rdf:Property",
      "rdfs:label": "unitText",
      "rdfs:comment": "Human-readable unit expression used by the canonical Quantity schema."
    },
    {
      "@id": "rcra:credentialUri",
      "@type": "rdf:Property",
      "rdfs:label": "uri",
      "rdfs:comment": "Property uri."
    },
