    },
    {
      "@id": "ion:value",
      "@type": "rdf:Property",
      "rdfs:label": "value",
      "rdfs:comment": "Property value."
    },
    {
      "@id": "ion:voltage",
      "@type": "rdf:Property",
      "rdfs:label": "voltage",
      "rdfs:comment": "Property voltage."
    },
    {
