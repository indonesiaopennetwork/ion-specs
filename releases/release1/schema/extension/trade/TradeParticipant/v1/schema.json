{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/release1/schema/extension/trade/TradeParticipant/v1",
  "$ref": "#/$defs/IONTradeParticipant",
  "$defs": {
    "IONTradeParticipant": {
      "type": "object",
      "title": "IONTradeParticipant",
      "description": "Participant attributes used in Trade messages. Inherits the common ION participant role and person-or-organization identity model and carries the billing address used for the trade transaction.\n",
      "x-ion-layer": "ion",
      "additionalProperties": true,
      "x-ion-closed-extensions": false,
      "x-beckn-attaches-to": "Participant.participantAttributes",
      "x-jsonld": {
        "@context": "https://schema.ion.id/release1/schema/extension/trade/TradeParticipant/v1/context.jsonld",
        "@type": "ion:IONTradeParticipant"
      },
      "allOf": [
        {
          "$ref": "https://schema.ion.id/release1/schema/common/IONParticipant/v1/attributes.yaml#/components/schemas/IONParticipant"
        }
      ],
      "properties": {
        "role": {
          "$ref": "https://schema.ion.id/release1/schema/common/IONParticipant/v1/attributes.yaml#/components/schemas/IONParticipant/properties/role"
        },
        "person": {
          "$ref": "https://schema.ion.id/release1/schema/common/IONParticipant/v1/attributes.yaml#/components/schemas/IONParticipant/properties/person"
        },
        "organization": {
          "$ref": "https://schema.ion.id/release1/schema/common/IONParticipant/v1/attributes.yaml#/components/schemas/IONParticipant/properties/organization"
        },
        "billingAddress": {
          "$ref": "https://schema.ion.id/release1/schema/common/Address/v1/attributes.yaml#/components/schemas/IONAddress",
          "description": "Billing address associated with the participant for the trade transaction."
        }
      }
    }
  }
}
