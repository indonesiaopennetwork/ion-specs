      "@id": "ion:until",
      "@type": "xsd:dateTime"
    },
    "operatingHours": "ion:operatingHours",
    "locationId": "ion:locationId",
    "type": "ion:type",
    "dayFrom": "ion:dayFrom",
    "dayTo": "ion:dayTo",
