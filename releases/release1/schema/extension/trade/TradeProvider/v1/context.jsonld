      "@id": "ion:startTime",
      "@type": "xsd:time"
    },
    "endTime": {
      "@id": "ion:endTime",
      "@type": "xsd:time"
    },
    "closures": "ion:closures",
    "date": {
      "@id": "ion:date",
      "@type": "xsd:date"
    },
    "serviceabilityByCategory": "ion:serviceabilityByCategory",
    "categoryId": "ion:categoryId",
    "geo": "beckn:geo",
    "averagePreparationTime": "ion:averagePreparationTime",
    "providerCategories": "ion:providerCategories",
    "logistics": "ion:logistics",
    "preferredProviderId": "ion:preferredProviderId",
    "managedByMarketplace": "ion:managedByMarketplace",
    "commerceChannels": "ion:commerceChannels",
    "supported": "ion:supported",
    "authorizedStreamerIds": "ion:authorizedStreamerIds",
    "verification": "ion:verification",
    "validUntil": {
      "@id": "ion:validUntil",
      "@type": "xsd:date"
    },
    "caveats": "ion:caveats",

    "businessRegistration": "ion:businessRegistration",
    "trustMarks": "ion:trustMarks",
    "level": "ion:level",
    "categoryLicenses": "ion:categoryLicenses",
    "categoryIds": "ion:categoryIds",
    "licenseType": "ion:licenseType",
