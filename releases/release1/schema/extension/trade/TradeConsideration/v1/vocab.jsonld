{
  "@context": {
    "ion": "https://schema.ion.id/trade/consideration/v1#",
    "iontax": "https://schema.ion.id/core/tax/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "beckn": "https://schema.beckn.io/",
    "rccna": "https://schema.beckn.io/RetailConsideration#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:IONTradeConsideration",
      "@type": "rdfs:Class",
      "rdfs:label": "IONTradeConsideration",
      "rdfs:comment": "ION trade consideration extension. Extends RetailConsideration v2.1 and refines inherited breakup tax details with the shared IONTaxDetail schema.",
      "rdfs:subClassOf": {
        "@id": "rccna:RetailConsideration"
      },
      "skos:broader": {
        "@id": "beckn:Consideration"
      }
    },
    {
      "@id": "rccna:breakup",
      "@type": "rdf:Property",
      "rdfs:label": "breakup",
      "rdfs:comment": "Retail consideration price breakup refined by this vocabulary."
    },
    {
      "@id": "rccna:taxDetail",
      "@type": "rdf:Property",
      "rdfs:label": "taxDetail",
      "rdfs:comment": "Tax detail associated with a consideration breakup entry."
    },
    {
      "@id": "ion:feeType",
      "@type": "rdf:Property",
      "rdfs:label": "feeType",
      "rdfs:comment": "PERCENT repeats the shared PERCENT terms of the offers ordered. AMOUNT means feeValue is the order's total commission in the consideration currency."
    },
    {
      "@id": "ion:feeValue",
      "@type": "rdf:Property",
      "rdfs:label": "feeValue",
      "rdfs:comment": "Percentage (0-100) when feeType is PERCENT; the order's total commission in the consideration currency when feeType is AMOUNT."
    },
    {
      "@id": "ion:appliesTo",
      "@type": "rdf:Property",
      "rdfs:label": "appliesTo",
      "rdfs:comment": "Base for a PERCENT commission. ITEM_TOTAL is the item value excluding tax, delivery and packing; ORDER_TOTAL includes tax. Only for feeType PERCENT."
    },
    {
      "@id": "ion:feeAmount",
      "@type": "rdf:Property",
      "rdfs:label": "feeAmount",
      "rdfs:comment": "Total commission in the consideration currency for the items still ordered: the sum over every offer still ordered of all its policies.commission entries. Equals the settlement's commission.value at reconciliation."
    },
    {
      "@id": "ion:buyerFinderFee",
      "@type": "rdf:Property",
      "rdfs:label": "buyerFinderFee",
      "rdfs:comment": "The buyer finder fee the seller (BPP) pays the buyer app (BAP) for orders of an offer, deducted from the seller's payout. Not a charge to the buyer, and not part of breakup or totalAmount. On an offer's consideration: the fee terms (feeType, feeValue, appliesTo). On the contract's price consideration in force: feeAmount, the order's total (see IONBuyerFinderFee)."
    },
    {
      "@id": "ion:IONBuyerFinderFee",
      "@type": "rdfs:Class",
      "rdfs:label": "IONBuyerFinderFee",
      "rdfs:comment": "The buyer finder fee: what the seller (BPP) pays the buyer app (BAP) for orders of an offer, deducted from the seller's payout at settlement. Not a charge to the buyer, and not part of breakup or totalAmount.\nOn an offer's consideration the seller states the fee terms: feeType, feeValue, and for PERCENT appliesTo. One fee per offer.\nOn the contract's price consideration in force the BPP states feeAmount, the order's total: the sum, over every offer still ordered, of its fee on its own items -- PERCENT of the unit price (ITEM_TOTAL) or of the unit total with tax (ORDER_TOTAL), or the AMOUNT per unit, times the quantity still ordered. The BPP sets it in on_select and on_init and recomputes it in on_cancel and on_update after cancellations and returns. At reconciliation the settlement's commission.value (IONSettlementReconciliation) equals feeAmount."
    },
    {
      "@id": "ion:deliveryFee",
      "@type": "rdf:Property",
      "rdfs:label": "deliveryFee",
      "rdfs:comment": "On an offer's consideration: the charge per order for the seller's own delivery of the offer's items (see IONDeliveryFee). The contract states the charge as a DELIVERY_CHARGE breakup line, not with this field."
    },
    {
      "@id": "ion:amount",
      "@type": "rdf:Property",
      "rdfs:label": "amount",
      "rdfs:comment": "The delivery charge per order in the consideration currency, including any tax. 0 states free delivery."
    },
    {
      "@id": "ion:IONDeliveryFee",
      "@type": "rdfs:Class",
      "rdfs:label": "IONDeliveryFee",
      "rdfs:comment": "The charge the buyer pays for the seller's own delivery, stated on an offer's consideration. One charge per order: when an order's performanceMode is DELIVERY, the BPP charges the highest deliveryFee amount among the offers ordered, once, as a breakup line of type DELIVERY_CHARGE on the contract's price consideration, included in totalAmount. No charge for SELF_PICKUP, and none when no offer ordered states a deliveryFee.\nThe line stays while any item is still ordered and is refunded only when the whole order is cancelled. It is not part of the buyer finder fee base (IONBuyerFinderFee)."
    }
  ]
}
