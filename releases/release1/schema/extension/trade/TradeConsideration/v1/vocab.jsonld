{
  "@context": {
    "ion": "https://schema.ion.id/trade/consideration/v1#",
    "iontax": "https://schema.ion.id/core/tax/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "beckn": "https://schema.beckn.io/",
    "rccna": "https://schema.beckn.io/RetailConsideration#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:IONTradeConsideration",
      "@type": "rdfs:Class",
      "rdfs:label": "IONTradeConsideration",
      "rdfs:comment": "ION trade consideration extension. Extends RetailConsideration v2.1 and refines inherited breakup tax details with the shared IONTaxDetail schema.",
      "rdfs:subClassOf": {
        "@id": "rccna:RetailConsideration"
      },
      "skos:broader": {
        "@id": "beckn:Consideration"
      }
    },
    {
      "@id": "rccna:breakup",
      "@type": "rdf:Property",
      "rdfs:label": "breakup",
      "rdfs:comment": "Retail consideration price breakup refined by this vocabulary."
    },
    {
      "@id": "rccna:taxDetail",
      "@type": "rdf:Property",
      "rdfs:label": "taxDetail",
      "rdfs:comment": "Tax detail associated with a consideration breakup entry."
    },
    {
      "@id": "ion:commission",
      "@type": "rdf:Property",
      "rdfs:label": "commission",
      "rdfs:comment": "Commission the order comes to: what the seller (BPP) pays the buyer app (BAP), deducted from the seller's payout. Not a charge to the buyer, and not part of breakup or totalAmount. Set only on the contract's price consideration in force; the offer's commission terms are IONTradeOffer.policies.commission (see IONCommission)."
    },
    {
      "@id": "ion:IONCommission",
      "@type": "rdfs:Class",
      "rdfs:label": "IONCommission",
      "rdfs:comment": "The commission an order comes to: what the seller (BPP) pays the buyer app (BAP), deducted from the seller's payout at settlement. Not a charge to the buyer, and not part of breakup or totalAmount. Set only on the contract's price consideration in force; the offer's terms are the named entries of IONTradeOffer.policies.commission.\namount is the total commission for the items still ordered: the sum, over every offer still ordered, of all its policies.commission entries. The BPP sets it in on_select and on_init and recomputes it in on_cancel and on_update after cancellations and returns.\nWhen every offer still ordered has exactly one commission entry and they all share the same PERCENT terms, the contract repeats that type, value and appliesTo; otherwise type is AMOUNT and value is the total.\nAt reconciliation the settlement's commission.value (IONSettlementReconciliation) equals amount."
    },
    {
      "@id": "ion:commissionType",
      "@type": "rdf:Property",
      "rdfs:label": "type",
      "rdfs:comment": "PERCENT repeats the shared PERCENT terms of the offers ordered. AMOUNT means value is the order's total commission in the consideration currency."
    },
    {
      "@id": "ion:commissionValue",
      "@type": "rdf:Property",
      "rdfs:label": "value",
      "rdfs:comment": "Percentage (0-100) when type is PERCENT; the order's total commission in the consideration currency when type is AMOUNT."
    },
    {
      "@id": "ion:commissionAppliesTo",
      "@type": "rdf:Property",
      "rdfs:label": "appliesTo",
      "rdfs:comment": "Base for a PERCENT commission. ITEM_TOTAL is the item value excluding tax, delivery and packing; ORDER_TOTAL includes tax. Only for type PERCENT."
    },
    {
      "@id": "ion:commissionAmount",
      "@type": "rdf:Property",
      "rdfs:label": "amount",
      "rdfs:comment": "Total commission in the consideration currency for the items still ordered: the sum over every offer still ordered of all its policies.commission entries. Equals the settlement's commission.value at reconciliation."
    }
  ]
}
