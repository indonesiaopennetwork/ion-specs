{
  "@context": "https://schema.ion.id/release1/schema/extension/trade/TradeOffer/v1/context.jsonld",
  "@type": "ion:IONTradeOffer",
  "_comment": "Example: an offer whose seller pays the buyer app two commission entries that add up — a 3% finder fee on the item value excluding tax, and a platform fee of IDR 250 per unit sold",
  "policies": {
    "returns": {
      "allowed": false,
      "policyRef": "ion://policy/return.standard.none"
    },
    "cancellation": {
      "policyRef": "ion://policy/cancel.prepacked.free"
    },
    "settlement": {
      "settlementBasis": "AFTER_DELIVERY",
      "settlementWindow": "P1D"
    },
    "commission": [
      {
        "feeName": "Finder fee",
        "feeType": "PERCENT",
        "feeValue": 3,
        "appliesTo": "ITEM_TOTAL"
      },
      {
        "feeName": "Platform fee",
        "feeType": "AMOUNT",
        "feeValue": 250
      }
    ]
  }
}
