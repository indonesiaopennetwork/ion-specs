{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/release1/schema/extension/logistics/LogisticsParticipant/v1",
  "$ref": "#/$defs/IONLogisticsParticipant",
  "$defs": {
    "DriverLicence": {
      "type": "object",
      "title": "Indonesian Driver Licence",
      "additionalProperties": false,
      "required": [
        "number",
        "category"
      ],
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1,
          "x-ion-data-residency": "ID",
          "description": "Indonesian SIM licence number."
        },
        "category": {
          "type": "string",
          "enum": [
            "A",
            "B_I",
            "B_II",
            "C",
            "D"
          ],
          "description": "Indonesian SIM vehicle category.",
          "x-ion-regulatory": "UU 22/2009 LLAJ; Perpol 5/2021"
        }
      }
    },
    "CustomsBrokerLicence": {
      "type": "object",
      "title": "Indonesian Customs Broker Licence",
      "additionalProperties": false,
      "required": [
        "number"
      ],
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1,
          "x-ion-data-residency": "ID",
          "description": "PPJK customs-broker licence number.",
          "x-ion-regulatory": "PMK 219/PMK.04/2019 tentang PPJK"
        }
      }
    },
    "LogisticsParticipant": {
      "type": "object",
      "title": "LogisticsParticipant",
      "description": "Geography-neutral logistics roles performed by a Participant.",
      "additionalProperties": true,
      "x-ion-closed-extensions": false,
      "x-beckn-attaches-to": "Participant.participantAttributes",
      "x-jsonld": {
        "@context": "https://schema.ion.id/release1/schema/extension/logistics/LogisticsParticipant/v1/context.jsonld",
        "@type": "ion:LogisticsParticipant"
      },
      "allOf": [
        {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/Attributes/2.0/attributes.yaml#/components/schemas/Attributes"
        }
      ],
      "properties": {
        "participantRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "COURIER",
              "DRIVER",
              "CUSTOMS_BROKER"
            ]
          },
          "description": "Logistics roles performed by the participant in the applicable relationship or transaction."
        }
      }
    },
    "IONLogisticsParticipant": {
      "type": "object",
      "title": "IONLogisticsParticipant",
      "description": "Logistics participant attributes extended with Indonesian licence details.",
      "x-ion-layer": "ion",
      "additionalProperties": true,
      "x-ion-closed-extensions": false,
      "x-beckn-attaches-to": "Participant.participantAttributes",
      "x-jsonld": {
        "@context": "https://schema.ion.id/release1/schema/extension/logistics/LogisticsParticipant/v1/context.jsonld",
        "@type": "ion:IONLogisticsParticipant"
      },
      "allOf": [
        {
          "$ref": "#/$defs/LogisticsParticipant"
        }
      ],
      "properties": {
        "driverLicence": {
          "x-attr-ion-layer": "ion",
          "$ref": "#/$defs/DriverLicence",
          "x-ion-condition": "Required when participantRoles contains DRIVER."
        },
        "customsBrokerLicence": {
          "x-attr-ion-layer": "ion",
          "$ref": "#/$defs/CustomsBrokerLicence",
          "x-ion-condition": "Required when participantRoles contains CUSTOMS_BROKER."
        }
      }
    }
  }
}
