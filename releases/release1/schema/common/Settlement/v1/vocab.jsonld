{
  "@context": {
    "ion": "https://schema.ion.id/core/settlement/v1#",
    "ionpay": "https://schema.ion.id/core/payment/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "beckn": "https://schema.beckn.io/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:IONSettlementReconciliation",
      "@type": "rdfs:Class",
      "rdfs:label": "IONSettlementReconciliation",
      "rdfs:comment": "The order's settlement, carried as one object from init to reconciliation. The BAP declares it in init (its payout account, payment method, status PENDING, and estimated figures); the BPP answers in on_init (its payout account, and the figures on its final price, with commission equal to the contract consideration's commission.feeAmount); the BAP records the payment in confirm (status PAID, paidAt, gatewayRef, orderAmount = amount paid); the BPP keeps the figures current in on_cancel and on_update; and each participant sends its figures in /reconcile and /on_reconcile. Before reconciliation the figures are estimates. The buyer's payment is held at the PJP; the figures split it. Invariant: orderAmount.value = netPayable.value + commission.value + withholdingAmount.value + refundAmount.value. On agreement SEAM instructs the PJP to pay netPayable to the BPP and commission to the BAP, return refundAmount to the buyer, and keep withholdingAmount. The payment fields reuse the IONPayment definitions. The payout falls due as the commitments' offers state in policies.settlement (IONTradeOffer); with several offers, the one giving the latest due date applies. Earlier versions carried settlementBasis, settlementWindow and finderFee here; orders that still carry them remain valid (additionalProperties is true), but new settlements omit them."
    },
    {
      "@id": "ion:ReconAmount",
      "@type": "rdfs:Class",
      "rdfs:label": "ReconAmount",
      "rdfs:comment": "One settlement component. In /on_reconcile, diffValue is the counterparty's value minus the value in the /reconcile being answered; it is present only when the two differ."
    },
    {
      "@id": "ion:Dispute",
      "@type": "rdfs:Class",
      "rdfs:label": "Dispute",
      "rdfs:comment": "Why the counterparty disagrees with a contract's figures. Required when accord is false."
    },
    {
      "@id": "ion:SettlementBasis",
      "@type": "rdfs:Class",
      "rdfs:label": "SettlementBasis",
      "rdfs:comment": "Contract lifecycle event from which a settlement falls due. ON_CONFIRMATION starts at order confirmation, AFTER_SHIPMENT at hand-over to logistics, AFTER_DELIVERY at confirmed delivery, and AFTER_RETURN_WINDOW when the applicable return window closes."
    },
    {
      "@id": "ion:SettlementWindow",
      "@type": "rdfs:Class",
      "rdfs:label": "SettlementWindow",
      "rdfs:comment": "ISO 8601 duration, measured from the SettlementBasis event, within which the settlement must be paid out."
    },
    {
      "@id": "ionpay:collectedBy",
      "@type": "rdf:Property",
      "rdfs:label": "collectedBy",
      "rdfs:comment": "Network participant whose checkout collected the buyer payment into the PJP (IONPayment.collectedBy)."
    },
    {
      "@id": "ionpay:currency",
      "@type": "rdf:Property",
      "rdfs:label": "currency",
      "rdfs:comment": "ISO 4217 currency of every amount in the settlement (IONPayment.currency)."
    },
    {
      "@id": "ionpay:method",
      "@type": "rdf:Property",
      "rdfs:label": "method",
      "rdfs:comment": "Payment method the buyer uses (IONPayment.method)."
    },
    {
      "@id": "ionpay:paymentRail",
      "@type": "rdf:Property",
      "rdfs:label": "paymentRail",
      "rdfs:comment": "Payment rail that carries the buyer payment (IONPayment.paymentRail)."
    },
    {
      "@id": "ionpay:paymentGatewayProvider",
      "@type": "rdf:Property",
      "rdfs:label": "paymentGatewayProvider",
      "rdfs:comment": "Payment gateway that processes the buyer payment (IONPayment.paymentGatewayProvider)."
    },
    {
      "@id": "ionpay:methodDetail",
      "@type": "rdf:Property",
      "rdfs:label": "methodDetail",
      "rdfs:comment": "Instrument-specific payment details, such as the QRIS string or virtual account number (IONPayment.methodDetail)."
    },
    {
      "@id": "ionpay:timing",
      "@type": "rdf:Property",
      "rdfs:label": "timing",
      "rdfs:comment": "When the payment is collected relative to fulfilment (IONPayment.timing)."
    },
    {
      "@id": "ionpay:status",
      "@type": "rdf:Property",
      "rdfs:label": "status",
      "rdfs:comment": "Payment status: PENDING until the buyer pays, then PAID (IONPayment.status)."
    },
    {
      "@id": "ionpay:paidAt",
      "@type": "rdf:Property",
      "rdfs:label": "paidAt",
      "rdfs:comment": "Timestamp of successful payment confirmation; required when status is PAID (IONPayment.paidAt)."
    },
    {
      "@id": "ionpay:gatewayRef",
      "@type": "rdf:Property",
      "rdfs:label": "gatewayRef",
      "rdfs:comment": "Payment gateway transaction reference (IONPayment.gatewayRef)."
    },
    {
      "@id": "ionpay:settlementAccounts",
      "@type": "rdf:Property",
      "rdfs:label": "settlementAccounts",
      "rdfs:comment": "Payout accounts as declared on IONPayment.settlementAccounts in the order. The BPP account is always required; the BAP account is required when commission is greater than zero."
    },
    {
      "@id": "ionpay:holderRole",
      "@type": "rdf:Property",
      "rdfs:label": "holderRole",
      "rdfs:comment": "Network participant (BAP or BPP) that owns a settlement account and receives payouts into it (IONPayment SettlementAccount.holderRole)."
    },
    {
      "@id": "ion:orderAmount",
      "@type": "rdf:Property",
      "rdfs:label": "orderAmount",
      "rdfs:comment": "Gross amount the buyer paid for the contract, held at the PJP.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:commission",
      "@type": "rdf:Property",
      "rdfs:label": "commission",
      "rdfs:comment": "Commission the BPP pays the BAP for the contract, equal to commission.feeAmount on the contract's price consideration in force (IONTradeConsideration), which sums the offers' policies.commission entries; the PJP pays it to the BAP. Zero when the offers carry no commission.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:withholdingAmount",
      "@type": "rdf:Property",
      "rdfs:label": "withholdingAmount",
      "rdfs:comment": "Amount the PJP keeps back, for example against returns.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:refundAmount",
      "@type": "rdf:Property",
      "rdfs:label": "refundAmount",
      "rdfs:comment": "Total the PJP returns to the buyer for the contract.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:netPayable",
      "@type": "rdf:Property",
      "rdfs:label": "netPayable",
      "rdfs:comment": "Amount the PJP pays to the BPP for this contract: orderAmount − commission − withholdingAmount − refundAmount.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:accord",
      "@type": "rdf:Property",
      "rdfs:label": "accord",
      "rdfs:comment": "Set only in /on_reconcile. true — the counterparty agrees with the figures it received; both participants have agreed and SEAM triggers the payout. false — it disagrees; see diffValue and dispute.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:dueDate",
      "@type": "rdf:Property",
      "rdfs:label": "dueDate",
      "rdfs:comment": "Date by which the payout is due. Required when accord is true.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:dispute",
      "@type": "rdf:Property",
      "rdfs:label": "dispute",
      "rdfs:comment": "Why the counterparty disagrees with a contract's figures. Required when accord is false.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:value",
      "@type": "rdf:Property",
      "rdfs:label": "value",
      "rdfs:comment": "Component amount in the settlement currency.",
      "rdfs:domain": {
        "@id": "ion:ReconAmount"
      }
    },
    {
      "@id": "ion:diffValue",
      "@type": "rdf:Property",
      "rdfs:label": "diffValue",
      "rdfs:comment": "Counterparty's value minus the value it is answering, when they differ.",
      "rdfs:domain": {
        "@id": "ion:ReconAmount"
      }
    },
    {
      "@id": "ion:code",
      "@type": "rdf:Property",
      "rdfs:label": "code",
      "rdfs:comment": "Short machine-readable reason, for example COMMISSION_MISMATCH.",
      "rdfs:domain": {
        "@id": "ion:Dispute"
      }
    },
    {
      "@id": "ion:description",
      "@type": "rdf:Property",
      "rdfs:label": "description",
      "rdfs:comment": "Human-readable explanation of the disagreement.",
      "rdfs:domain": {
        "@id": "ion:Dispute"
      }
    },
    {
      "@id": "ion:recoveryAmount",
      "@type": "rdf:Property",
      "rdfs:label": "recoveryAmount",
      "rdfs:comment": "Amount owed back on a correction settlement (relatedSettlementId), for example after a chargeback or a refund forced after payout, when it exceeds what is still to be paid. Amounts are never negative; a recovery is stated here instead."
    },
    {
      "@id": "ion:orderDate",
      "@type": "rdf:Property",
      "rdfs:label": "orderDate",
      "rdfs:comment": "Date the order was created, in Asia/Jakarta time (UTC+07:00), taken from the order's original creation timestamp. Groups settlements by order day; it is not the due date."
    },
    {
      "@id": "ion:breakup",
      "@type": "rdf:Property",
      "rdfs:label": "breakup",
      "rdfs:comment": "Optional itemization of the figures. Entries with includedIn COMMISSION, WITHHOLDING or REFUND explain part of that amount and are not deducted again; ADDITIONAL entries change netPayable by their effectOnNetPayable."
    },
    {
      "@id": "ion:collections",
      "@type": "rdf:Property",
      "rdfs:label": "collections",
      "rdfs:comment": "Optional record of who collected the buyer's money and how much, for the cases the payment fields do not describe: cash on delivery, credit, bank transfer, partial or mixed collection. Reported by the sender; it is not proof of funds."
    },
    {
      "@id": "ion:settlementObligations",
      "@type": "rdf:Property",
      "rdfs:label": "settlementObligations",
      "rdfs:comment": "Optional, informational: who is expected to pay whom, for example a cash-on-delivery collector remitting to the BPP and the BPP paying the BAP's commission. Not a payment instruction; legs that pass on the same money are not added up as separate value."
    },
    {
      "@id": "ion:relatedSettlementId",
      "@type": "rdf:Property",
      "rdfs:label": "relatedSettlementId",
      "rdfs:comment": "On a correction settlement, the Settlement.id of the earlier settlement it adjusts. The correction has its own Settlement.id; the earlier settlement is not sent or paid again."
    },
    {
      "@id": "ion:adjustmentType",
      "@type": "rdf:Property",
      "rdfs:label": "adjustmentType",
      "rdfs:comment": "Kind of correction. Requires relatedSettlementId."
    },
    {
      "@id": "ion:field",
      "@type": "rdf:Property",
      "rdfs:label": "field",
      "rdfs:comment": "Name of the field in dispute, for example commission or a breakup code, when the disagreement is about one figure."
    },
    {
      "@id": "ion:referenceId",
      "@type": "rdf:Property",
      "rdfs:label": "referenceId",
      "rdfs:comment": "Reference the disagreement rests on, such as an invoice or settlement ID."
    },
    {
      "@id": "ion:includedIn",
      "@type": "rdf:Property",
      "rdfs:label": "includedIn",
      "rdfs:comment": "The amount this entry is part of. ADDITIONAL: not part of commission, withholdingAmount or refundAmount; it changes netPayable by effectOnNetPayable."
    },
    {
      "@id": "ion:amount",
      "@type": "rdf:Property",
      "rdfs:label": "amount",
      "rdfs:comment": "Size of the entry, in the settlement currency."
    },
    {
      "@id": "ion:effectOnNetPayable",
      "@type": "rdf:Property",
      "rdfs:label": "effectOnNetPayable",
      "rdfs:comment": "Signed change to netPayable; required when includedIn is ADDITIONAL. Negative for a fee or penalty charged to the BPP, positive for a credit to it."
    },
    {
      "@id": "ion:collectorRole",
      "@type": "rdf:Property",
      "rdfs:label": "collectorRole",
      "rdfs:comment": "Who holds the money collected; BUYER when nothing has been collected yet on credit."
    },
    {
      "@id": "ion:collectorId",
      "@type": "rdf:Property",
      "rdfs:label": "collectorId",
      "rdfs:comment": "Identifier of the collector, such as a subscriber ID or the BPP's ID for a seller or courier."
    },
    {
      "@id": "ion:reportedCollectedAmount",
      "@type": "rdf:Property",
      "rdfs:label": "reportedCollectedAmount",
      "rdfs:comment": "Amount the sender reports as collected so far."
    },
    {
      "@id": "ion:payerId",
      "@type": "rdf:Property",
      "rdfs:label": "payerId",
      "rdfs:comment": "Who is expected to pay."
    },
    {
      "@id": "ion:payeeId",
      "@type": "rdf:Property",
      "rdfs:label": "payeeId",
      "rdfs:comment": "Who is expected to receive."
    },
    {
      "@id": "ion:purpose",
      "@type": "rdf:Property",
      "rdfs:label": "purpose",
      "rdfs:comment": "What the payment is for."
    },
    {
      "@id": "ion:FinancialComponent",
      "@type": "rdfs:Class",
      "rdfs:label": "FinancialComponent",
      "rdfs:comment": "One itemized part of a settlement's figures. Amounts are explained once: an entry included in commission, withholdingAmount or refundAmount is not deducted again."
    },
    {
      "@id": "ion:CollectionInformation",
      "@type": "rdfs:Class",
      "rdfs:label": "CollectionInformation",
      "rdfs:comment": "One collection of the buyer's money, as reported by the sender. Not proof of funds: SEAM verifies collections separately."
    },
    {
      "@id": "ion:SettlementObligation",
      "@type": "rdfs:Class",
      "rdfs:label": "SettlementObligation",
      "rdfs:comment": "One expected payment between parties, for information. It is not a payment instruction."
    },
    {
      "@id": "ion:allocationFor",
      "@type": "rdf:Property",
      "rdfs:label": "allocationFor",
      "rdfs:comment": "allocationFor property."
    }
  ]
}
