{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/release1/schema/common/Location/v1",
  "$ref": "#/$defs/Location",
  "$defs": {
    "Location": {
      "type": "object",
      "title": "Location",
      "description": "Geographic or postal representation of a place. At least one of geo or address must be supplied. Geometry is authoritative when both are present.\n",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["geo"]},
        {"required": ["address"]}
      ],
      "x-jsonld": {
        "@context": "https://schema.ion.id/release1/schema/common/Location/v1/context.jsonld",
        "@type": "ion:Location"
      },
      "properties": {
        "geo": {
          "$ref": "https://schema.ion.id/release1/schema/vendored/beckn/schemas/GeoJSONGeometry/2.0/attributes.yaml#/components/schemas/GeoJSONGeometry",
          "description": "GeoJSON geometry for the place."
        },
        "address": {
          "$ref": "https://schema.ion.id/release1/schema/common/Address/v1/attributes.yaml#/components/schemas/Address",
          "description": "Postal address, including its addressAttributes extension point."
        }
      }
    }
  }
}
