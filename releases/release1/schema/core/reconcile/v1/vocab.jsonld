{
  "@context": {
    "ion": "https://schema.ion.id/core/reconcile/v1#",
    "ionpay": "https://schema.ion.id/core/payment/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "beckn": "https://schema.beckn.io/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@graph": [
    {
      "@id": "ion:IONSettlementReconciliation",
      "@type": "rdfs:Class",
      "rdfs:label": "IONSettlementReconciliation",
      "rdfs:comment": "One participant's reconciliation figures for a contract's settlement. The buyer's payment is held at the PJP; the figures split it. Invariant: orderAmount.value = netPayable.value + commission.value + withholdingAmount.value + refundAmount.value. On agreement SEAM instructs the PJP to pay netPayable to the BPP and commission to the BAP, return refundAmount to the buyer, and keep withholdingAmount. collectedBy, currency, and settlementAccounts reuse the IONPayment definitions."
    },
    {
      "@id": "ion:ReconAmount",
      "@type": "rdfs:Class",
      "rdfs:label": "ReconAmount",
      "rdfs:comment": "One settlement component. In /on_reconcile, diffValue is the counterparty's value minus the value in the /reconcile being answered; it is present only when the two differ."
    },
    {
      "@id": "ion:Dispute",
      "@type": "rdfs:Class",
      "rdfs:label": "Dispute",
      "rdfs:comment": "Why the counterparty disagrees with a contract's figures. Required when accord is false."
    },
    {
      "@id": "ion:FinderFee",
      "@type": "rdfs:Class",
      "rdfs:label": "FinderFee",
      "rdfs:comment": "Fee the Consumer Node (BAP) earns for bringing the order, agreed in init and on_init. Reconciliation computes the fee amount from these terms and reports it as the contract's commission."
    },
    {
      "@id": "ion:SettlementBasis",
      "@type": "rdfs:Class",
      "rdfs:label": "SettlementBasis",
      "rdfs:comment": "Contract lifecycle event from which a settlement falls due. ON_CONFIRMATION starts at order confirmation, AFTER_SHIPMENT at hand-over to logistics, AFTER_DELIVERY at confirmed delivery, and AFTER_RETURN_WINDOW when the applicable return window closes."
    },
    {
      "@id": "ion:SettlementWindow",
      "@type": "rdfs:Class",
      "rdfs:label": "SettlementWindow",
      "rdfs:comment": "ISO 8601 duration, measured from the SettlementBasis event, within which the settlement must be paid out."
    },
    {
      "@id": "ionpay:collectedBy",
      "@type": "rdf:Property",
      "rdfs:label": "collectedBy",
      "rdfs:comment": "Network participant whose checkout collected the buyer payment into the PJP (IONPayment.collectedBy)."
    },
    {
      "@id": "ionpay:currency",
      "@type": "rdf:Property",
      "rdfs:label": "currency",
      "rdfs:comment": "ISO 4217 currency of every amount in the settlement (IONPayment.currency)."
    },
    {
      "@id": "ionpay:settlementAccounts",
      "@type": "rdf:Property",
      "rdfs:label": "settlementAccounts",
      "rdfs:comment": "Payout accounts as declared on IONPayment.settlementAccounts in the order. The BPP account is always required; the BAP account is required when commission is greater than zero."
    },
    {
      "@id": "ionpay:holderRole",
      "@type": "rdf:Property",
      "rdfs:label": "holderRole",
      "rdfs:comment": "Network participant (BAP or BPP) that owns a settlement account and receives payouts into it (IONPayment SettlementAccount.holderRole)."
    },
    {
      "@id": "ion:settlementBasis",
      "@type": "rdf:Property",
      "rdfs:label": "settlementBasis",
      "rdfs:comment": "Contract lifecycle event from which a settlement falls due. ON_CONFIRMATION starts at order confirmation, AFTER_SHIPMENT at hand-over to logistics, AFTER_DELIVERY at confirmed delivery, and AFTER_RETURN_WINDOW when the applicable return window closes.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:settlementWindow",
      "@type": "rdf:Property",
      "rdfs:label": "settlementWindow",
      "rdfs:comment": "ISO 8601 duration, measured from the SettlementBasis event, within which the settlement must be paid out.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:finderFee",
      "@type": "rdf:Property",
      "rdfs:label": "finderFee",
      "rdfs:comment": "Fee the Consumer Node (BAP) earns for bringing the order, agreed in init and on_init. Reconciliation computes the fee amount from these terms and reports it as the contract's commission.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:orderAmount",
      "@type": "rdf:Property",
      "rdfs:label": "orderAmount",
      "rdfs:comment": "Gross amount the buyer paid for the contract, held at the PJP.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:commission",
      "@type": "rdf:Property",
      "rdfs:label": "commission",
      "rdfs:comment": "BAP finder fee for the contract, computed from finderFee; the PJP pays it to the BAP. Zero when no finder fee was agreed.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:withholdingAmount",
      "@type": "rdf:Property",
      "rdfs:label": "withholdingAmount",
      "rdfs:comment": "Amount the PJP keeps back, for example against returns.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:refundAmount",
      "@type": "rdf:Property",
      "rdfs:label": "refundAmount",
      "rdfs:comment": "Total the PJP returns to the buyer for the contract.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:netPayable",
      "@type": "rdf:Property",
      "rdfs:label": "netPayable",
      "rdfs:comment": "Amount the PJP pays to the BPP for this contract: orderAmount \u2212 commission \u2212 withholdingAmount \u2212 refundAmount.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:accord",
      "@type": "rdf:Property",
      "rdfs:label": "accord",
      "rdfs:comment": "Set only in /on_reconcile. true \u2014 the counterparty agrees with the figures it received; both participants have agreed and SEAM triggers the payout. false \u2014 it disagrees; see diffValue and dispute.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:dueDate",
      "@type": "rdf:Property",
      "rdfs:label": "dueDate",
      "rdfs:comment": "Date by which the payout is due. Required when accord is true.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:dispute",
      "@type": "rdf:Property",
      "rdfs:label": "dispute",
      "rdfs:comment": "Why the counterparty disagrees with a contract's figures. Required when accord is false.",
      "rdfs:domain": {
        "@id": "ion:IONSettlementReconciliation"
      }
    },
    {
      "@id": "ion:value",
      "@type": "rdf:Property",
      "rdfs:label": "value",
      "rdfs:comment": "Component amount in the settlement currency.",
      "rdfs:domain": {
        "@id": "ion:ReconAmount"
      }
    },
    {
      "@id": "ion:diffValue",
      "@type": "rdf:Property",
      "rdfs:label": "diffValue",
      "rdfs:comment": "Counterparty's value minus the value it is answering, when they differ.",
      "rdfs:domain": {
        "@id": "ion:ReconAmount"
      }
    },
    {
      "@id": "ion:code",
      "@type": "rdf:Property",
      "rdfs:label": "code",
      "rdfs:comment": "Short machine-readable reason, for example COMMISSION_MISMATCH.",
      "rdfs:domain": {
        "@id": "ion:Dispute"
      }
    },
    {
      "@id": "ion:description",
      "@type": "rdf:Property",
      "rdfs:label": "description",
      "rdfs:comment": "Human-readable explanation of the disagreement.",
      "rdfs:domain": {
        "@id": "ion:Dispute"
      }
    },
    {
      "@id": "ion:feeType",
      "@type": "rdf:Property",
      "rdfs:label": "feeType",
      "rdfs:comment": "PERCENT applies feeValue as a percentage of the appliesTo base. AMOUNT is a fixed fee in the contract currency.",
      "rdfs:domain": {
        "@id": "ion:FinderFee"
      }
    },
    {
      "@id": "ion:feeValue",
      "@type": "rdf:Property",
      "rdfs:label": "feeValue",
      "rdfs:comment": "Fee percentage (0-100) when feeType is PERCENT; fee amount in the contract currency when feeType is AMOUNT.",
      "rdfs:domain": {
        "@id": "ion:FinderFee"
      }
    },
    {
      "@id": "ion:appliesTo",
      "@type": "rdf:Property",
      "rdfs:label": "appliesTo",
      "rdfs:comment": "Base for a PERCENT fee. ITEM_TOTAL is the item value excluding delivery, packing, and taxes; ORDER_TOTAL is the full consideration. Ignored when feeType is AMOUNT.",
      "rdfs:domain": {
        "@id": "ion:FinderFee"
      }
    }
  ]
}
