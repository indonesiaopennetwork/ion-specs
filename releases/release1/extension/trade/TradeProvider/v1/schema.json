{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.ion.id/releases/release1/extension/trade/TradeProvider/v1",
  "title": "ION Trade Provider Schema Pack v1",
  "$ref": "#/$defs/IONTradeProvider",
  "$defs": {
    "IONTradeProvider": {
      "type": "object",
      "title": "IONTradeProvider",
      "description": "ION trade-provider attributes carried by Provider.providerAttributes. Inherits directly from Beckn Attributes and combines generic provider operations with Indonesia-specific registration, trust, verification-tier, and category-licensing extensions. Properties originating in the former ION-specific layer are identified by x-attr-ion-layer: ion.",
      "x-ion-layer": "ion",
      "x-ion-split-version": "0.7.0",
      "x-recommended-parent": "Provider.providerAttributes",
      "additionalProperties": true,
      "x-jsonld": {
        "@context": "https://schema.ion.id/releases/release1/extension/trade/TradeProvider/v1/context.jsonld",
        "@type": "ion:IONTradeProvider"
      },
      "x-beckn-attaches-to": "Provider.providerAttributes",
      "x-ion-closed-extensions": false,
      "allOf": [
        {
          "$ref": "https://schema.beckn.io/Attributes/2.0/attributes.yaml#/components/schemas/Attributes"
        },
        {
          "type": "object",
          "properties": {
            "verification": {
              "allOf": [
                {
                  "type": "object",
                  "properties": {
                    "level": {
                      "type": "string",
                      "enum": [
                        "BASIC",
                        "STANDARD",
                        "ENHANCED",
                        "ENTERPRISE"
                      ],
                      "description": "ION provider-verification tier.",
                      "example": "STANDARD"
                    }
                  }
                }
              ],
              "x-attr-ion-layer": "ion"
            }
          }
        }
      ],
      "properties": {
        "invoicing": {
          "type": "object",
          "additionalProperties": false,
          "description": "Provider-level invoicing arrangement.",
          "properties": {
            "model": {
              "type": "string",
              "enum": [
                "CENTRAL",
                "PER_FULFILMENT_CENTRE"
              ],
              "x-ion-regulatory": "UU 6/1983 tentang Ketentuan Umum Perpajakan — NPWP obligation per taxable entity"
            },
            "entityId": {
              "type": "string",
              "description": "Identifier of the Participant or Provider that issues invoices when the model is CENTRAL.",
              "x-ion-regulatory": "PMK 168/PMK.010/2023 tentang Faktur Pajak"
            }
          }
        },
        "operationalStatus": {
          "type": "object",
          "additionalProperties": false,
          "description": "Current catalog-visible operating state of the provider.",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "OPEN",
                "TEMPORARILY_CLOSED",
                "DISABLED"
              ]
            },
            "until": {
              "type": "string",
              "format": "date-time",
              "description": "Expected end of a temporary closure."
            }
          }
        },
        "operatingHours": {
          "type": "array",
          "description": "Recurring weekly operating windows.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "locationId": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "ORDER",
                  "DELIVERY",
                  "SELF_PICKUP",
                  "PREPARATION"
                ]
              },
              "dayFrom": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "dayTo": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "startTime": {
                "type": "string",
                "format": "time"
              },
              "endTime": {
                "type": "string",
                "format": "time"
              }
            }
          }
        },
        "closures": {
          "type": "array",
          "description": "Exceptional dates on which the provider or a specific operating location is closed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "locationId": {
                "type": "string"
              }
            }
          }
        },
        "serviceabilityByCategory": {
          "type": "array",
          "description": "Provider-level geographic serviceability overrides for a category.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "categoryId": {
                "type": "string"
              },
              "locationId": {
                "type": "string"
              },
              "geo": {
                "$ref": "https://schema.ion.id/releases/release1/vendored/beckn/protocol/v2.0.0/beckn.yaml#/components/schemas/GeoJSONGeometry"
              }
            }
          }
        },
        "averagePreparationTime": {
          "type": "string",
          "format": "duration",
          "description": "Provider-level average duration from confirmation until a resource is ready for pickup or delivery.",
          "example": "PT25M"
        },
        "providerCategories": {
          "type": "array",
          "uniqueItems": true,
          "description": "Categories in which the provider operates.",
          "items": {
            "type": "string"
          },
          "x-ion-suggested-values": [
            "RESTAURANT",
            "CLOUD_KITCHEN",
            "GROCERY",
            "PHARMACY",
            "FASHION",
            "ELECTRONICS",
            "BEAUTY",
            "FMCG",
            "AGRITECH",
            "B2B_DISTRIBUTOR",
            "QUICK_COMMERCE",
            "HOME_AND_KITCHEN",
            "PET_SUPPLIES",
            "BOOKS_STATIONERY",
            "TOYS_GAMES",
            "SPORTS_OUTDOORS",
            "AUTOMOTIVE_PARTS"
          ]
        },
        "logistics": {
          "type": "object",
          "additionalProperties": false,
          "description": "Provider-level logistics arrangement and preference.",
          "properties": {
            "preferredProviderId": {
              "type": "string"
            },
            "managedByMarketplace": {
              "type": "boolean"
            }
          }
        },
        "commerceChannels": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional commerce channels supported by the provider.",
          "properties": {
            "supported": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "LIVE_COMMERCE",
                  "OTT_EMBEDDED_COMMERCE"
                ]
              }
            },
            "authorizedStreamerIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "description": "Catalog-visible summary of provider verification performed by the Provider Node.",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PENDING",
                "APPROVED",
                "APPROVED_WITH_CAVEATS",
                "REJECTED",
                "SUSPENDED",
                "EXPIRED"
              ]
            },
            "validUntil": {
              "type": "string",
              "format": "date"
            },
            "caveats": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "PENDING_BENEFICIAL_OWNERSHIP",
                  "PENDING_AML_SCREEN",
                  "PENDING_CATEGORY_LICENSE",
                  "PENDING_FINAL_VERIFICATION",
                  "PROBATIONARY_PERIOD"
                ]
              }
            }
          }
        },
        "businessRegistration": {
          "$ref": "https://schema.ion.id/releases/release1/common/BusinessRegistration/v1/attributes.yaml#/components/schemas/IONBusinessRegistration",
          "description": "Indonesian business identity for the provider. The actual nib replaces the former nibRegistered boolean.",
          "x-attr-ion-layer": "ion"
        },
        "trustMarks": {
          "type": "array",
          "description": "Signed or otherwise verifiable trust marks awarded to the provider.",
          "items": {
            "$ref": "https://schema.ion.id/releases/release1/vendored/beckn/protocol/v2.0.0/beckn.yaml#/components/schemas/Document"
          },
          "x-attr-ion-layer": "ion"
        },
        "categoryLicenses": {
          "type": "array",
          "description": "Indonesian operating licences applicable to one or more provider categories.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "categoryIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "licenseType": {
                "type": "string",
                "x-ion-suggested-values": [
                  "SIA_ALCOHOL",
                  "SIKA_MEAT",
                  "PBF_PHARMACY",
                  "BPOM_COSMETICS",
                  "BPOM_FOOD",
                  "SIUP_HEAVY",
                  "OTHER"
                ]
              },
              "licenseNumber": {
                "type": "string"
              },
              "validUntil": {
                "type": "string",
                "format": "date"
              },
              "issuingAuthority": {
                "type": "string"
              },
              "evidence": {
                "$ref": "https://schema.ion.id/releases/release1/vendored/beckn/protocol/v2.0.0/beckn.yaml#/components/schemas/Document"
              }
            }
          },
          "x-ion-regulatory": "PP 5/2021; PerBPOM various",
          "x-attr-ion-layer": "ion"
        }
      }
    }
  }
}
